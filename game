const Audio_ = {
  ctx: null,
  enabled: true,
  master: null,

  init() {
    if (this.ctx) return;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) { this.enabled = false; return; }
    try {
      this.ctx = new AC();
      this.master = this.ctx.createGain();
      this.master.gain.value = 0.5;
      this.master.connect(this.ctx.destination);
    } catch (e) { this.enabled = false; }
  },

  resume() {
    if (!this.enabled) return;
    this.init();
    if (this.ctx && this.ctx.state === "suspended") this.ctx.resume();
  },

  // 释放波：按主题给出不同的音色
  wave(strength, theme) {
    if (!this.enabled || !this.ctx) return;
    const A = (theme && theme.audio) || THEMES.space.audio;
    const t = this.ctx.currentTime;
    const o = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    const f = this.ctx.createBiquadFilter();
    f.type = "lowpass";

    let base = A.base;
    let tail = A.tail;
    let filt = 700 + strength * 500;
    let dur = 0.8;

    if (A.fx === "water") {
      // 水面：高频的水滴感，尾音短
      o.type = "sine";
      filt = 1400 + strength * 900;
      o.frequency.setValueAtTime(base + 260 - strength * 60, t);
      o.frequency.exponentialRampToValueAtTime(base + 40, t + 0.42);
      dur = 0.7;
    } else if (A.fx === "deep") {
      // 深海：低频声呐，尾音长，带下潜
      o.type = "sine";
      filt = 320;
      o.frequency.setValueAtTime(base + 60, t);
      o.frequency.exponentialRampToValueAtTime(base - 28, t + 1.5);
      dur = 1.7;
    } else if (A.fx === "aurora") {
      // 极光：清冷的铃音，基频更高
      o.type = "triangle";
      filt = 2200 + strength * 1200;
      o.frequency.setValueAtTime(base + 180, t);
      o.frequency.exponentialRampToValueAtTime(base + 40, t + 0.9);
      dur = 1.1;
    } else if (A.fx === "desert") {
      // 荒漠：干燥的沙沙感，中频短促
      o.type = "triangle";
      filt = 900 + strength * 500;
      o.frequency.setValueAtTime(base + 90, t);
      o.frequency.exponentialRampToValueAtTime(base + 20, t + 0.55);
      dur = 0.8;
    } else if (A.fx === "forest") {
      // 林间：木质感的柔和敲击
      o.type = "sine";
      filt = 1100 + strength * 700;
      o.frequency.setValueAtTime(base + 200, t);
      o.frequency.exponentialRampToValueAtTime(base + 60, t + 0.7);
      dur = 0.9;
    } else if (A.fx === "ice") {
      // 冰原：清脆的晶体音，高频带尾韵
      o.type = "triangle";
      filt = 2600 + strength * 1400;
      o.frequency.setValueAtTime(base + 320, t);
      o.frequency.exponentialRampToValueAtTime(base + 70, t + 1.3);
      dur = 1.5;
    } else if (A.fx === "ember") {
      // 熔岩：粗糙的低吼，尾音下沉
      o.type = "sawtooth";
      filt = 380;
      o.frequency.setValueAtTime(base + 48, t);
      o.frequency.exponentialRampToValueAtTime(base - 22, t + 1.4);
      dur = 1.6;
    } else {
      // 太空：低沉的空间感嗡鸣 + 缓慢下沉
      o.type = "sine";
      filt = 600 + strength * 420;
      o.frequency.setValueAtTime(base + 132 - strength * 50, t);
      o.frequency.exponentialRampToValueAtTime(base - 18, t + tail);
      dur = 1.0;
    }

    f.frequency.value = filt;
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.085 * (0.5 + strength), t + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);

    o.connect(f); f.connect(g); g.connect(this.master);
    o.start(t); o.stop(t + dur + 0.05);
  },

  // 碎片进入光圈：按主题音阶给出清脆的点
  enter(pitch, theme) {
    if (!this.enabled || !this.ctx) return;
    const A = (theme && theme.audio) || THEMES.space.audio;
    const t = this.ctx.currentTime;
    const o = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    o.type = A.type || "triangle";

    // 用主题音阶把音高量化，避免每次随机音听起来杂乱
    const steps = A.scale || [0, 3, 7, 10];
    const step = steps[Math.abs(Math.round(pitch)) % steps.length];
    const f0 = A.enter * Math.pow(2, step / 12);

    o.frequency.setValueAtTime(f0, t);
    o.frequency.exponentialRampToValueAtTime(f0 * 1.5, t + 0.16);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.05, t + 0.012);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.3);
    o.connect(g); g.connect(this.master);
    o.start(t); o.stop(t + 0.32);
  },

  // 通关：按主题给出不同的和弦色彩
  complete(theme) {
    if (!this.enabled || !this.ctx) return;
    const A = (theme && theme.audio) || THEMES.space.audio;
    const chords = {
      space: [392.00, 587.33, 783.99],   // G 大三和弦，开阔
      water: [440.00, 554.37, 659.25],   // A 大三和弦，明亮
      deep:  [261.63, 392.00, 523.25],   // C 大三和弦，低沉
      aurora:[523.25, 659.25, 987.77],   // C 高音区，清澈
      desert:[349.23, 466.16, 698.46],   // F 大三和弦，干燥温暖
      forest:[293.66, 440.00, 587.33],   // D 大三和弦，自然
      ice:   [493.88, 739.99, 987.77],   // B 大三和弦，凛冽
      ember: [233.08, 349.23, 466.16],   // Bb 大三和弦，厚重
    };
    const notes = chords[Object.keys(THEMES).find(k => THEMES[k] === theme)] || chords.space;
    const t0 = this.ctx.currentTime;
    notes.forEach((f, i) => {
      const t = t0 + i * 0.11;
      const o = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      o.type = A.type || "sine";
      o.frequency.value = f;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.07, t + 0.05);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 1.4);
      o.connect(g); g.connect(this.master);
      o.start(t); o.stop(t + 1.45);
    });
  },

  // 失败：一声下坠的低音
  fail() {
    if (!this.enabled || !this.ctx) return;
    const t = this.ctx.currentTime;
    const o = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    const f = this.ctx.createBiquadFilter();
    f.type = "lowpass";
    f.frequency.value = 420;
    o.type = "sine";
    o.frequency.setValueAtTime(220, t);
    o.frequency.exponentialRampToValueAtTime(88, t + 0.7);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.075, t + 0.03);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.85);
    o.connect(f); f.connect(g); g.connect(this.master);
    o.start(t); o.stop(t + 0.9);
  },

  // 拖拽蓄力：持续的细嗡声，可实时改频率与音量
  beginDrag() {
    if (!this.enabled || !this.ctx || this.dragOsc) return;
    const o = this.ctx.createOscillator();
    const g = this.ctx.createGain();
    o.type = "sine";
    o.frequency.value = 90;
    g.gain.value = 0.0001;
    o.connect(g); g.connect(this.master);
    o.start();
    this.dragOsc = o;
    this.dragGain = g;
  },

  updateDrag(t) {
    if (!this.dragOsc) return;
    const now = this.ctx.currentTime;
    this.dragOsc.frequency.setTargetAtTime(90 + t * 130, now, 0.06);
    this.dragGain.gain.setTargetAtTime(0.0001 + t * 0.035, now, 0.06);
  },

  endDrag() {
    if (!this.dragOsc) return;
    const now = this.ctx.currentTime;
    const o = this.dragOsc, g = this.dragGain;
    g.gain.setTargetAtTime(0.0001, now, 0.05);
    o.stop(now + 0.25);
    this.dragOsc = null;
    this.dragGain = null;
  },
};

/* ------------------ 实体 ------------------ */
// 轨迹方向：决定偏移作用在哪个轴上。
// 数值必须是 0 或 1，否则会按比例削减 driftAmplitude（例如 0.35 会让振幅只剩 35%）。
const DRIFT_MODES = {
  none:       { x: 0, y: 0 },
  horizontal: { x: 1, y: 0 },
  vertical:   { x: 0, y: 1 },
  orbit:      { x: 1, y: 1 },
  pause:      { x: 1, y: 0 },
};

// 碎片一旦停稳就"锁存"在光圈里，不会因为后续波纹、轨迹或余速被重新推出去。
// 记录已停稳的位置，每帧被拉回该位置，保证复访稳定、判定不回退。
function latchShard(s, dt) {
  if (!s.latch) s.latch = [s.x, s.y];
  // 轻轻收敛到记录点，而不是硬钉住，避免视觉上突然停顿
  const k = 1 - Math.exp(-14 * dt);
  s.x += (s.latch[0] - s.x) * k;
  s.y += (s.latch[1] - s.y) * k;
  s.vx = 0;
  s.vy = 0;
  s.inside = true;
  s.insideTime += dt;
  s.holdTime = 0;
}

class Shard {
  constructor(cfg, index, seed) {
    // 半径下限随屏幕调整：手机上要看得清、也方便判断位置
    this.r = Math.max((cfg.r || 14) * SCALE, W < 720 ? 11 : 8);
    this.mass = cfg.mass || 1;
    this.index = index;
    this.order = cfg.order || 0;          // 顺序目标：0 表示不限制
    this.lockedAtStart = !!cfg.locked;
    this.unlockOrder = cfg.unlockOrder || 0; // locked 碎片被第几号波纹解锁
    this.settleDuration = cfg.settleDuration || 0;
    this.bounce = cfg.bounce || 0;

    // 预设轨迹：完全由配置 + 关卡 seed 决定，不使用自由随机漂移
    this.driftMode = cfg.driftMode || (cfg.drift ? "horizontal" : "none");
    const amp = cfg.driftAmplitude != null ? cfg.driftAmplitude
      : (cfg.drift ? Math.hypot(cfg.drift[0], cfg.drift[1]) : 0);
    this.driftAmplitude = amp * SCALE;
    this.driftPeriod = cfg.driftPeriod || 3.2;
    this.driftStart = cfg.driftStart || 0;
    this.driftAxis = DRIFT_MODES[this.driftMode] || DRIFT_MODES.none;
    this.driftAngle = ((cfg.driftAngle != null ? cfg.driftAngle : 0) * Math.PI) / 180;

    this.home = [CX + cfg.x * SCALE, CY + cfg.y * SCALE];
    this.x = this.home[0];
    this.y = this.home[1];
    this.vx = 0;
    this.vy = 0;

    this.inside = false;       // 是否在光圈内
    this.insideTime = 0;       // 在光圈内累计停留时长
    this.holdTime = 0;         // 满足停驻条件后的持续计时
    this.settled = false;      // 已完成
    this.glow = 0;             // 进入时的闪光
    this.pulse = 0;            // 被波推动时的挤压
    this.driftNow = 0;         // 当前轨迹偏移（供绘制轨迹线用）
    this.obstacleHitAt = -1;   // 上一次穿过危险区的时刻

    // 视觉姿态相位：由关卡 seed 固定，保证同一关每次一致
    const rnd = seeded((seed || 1) * 7919 + index * 613);
    this.phase = rnd() * TAU;
    this.driftPhase = rnd() * TAU;

    this.resetToStart();
  }

  resetToStart() {
    this.locked = this.lockedAtStart;
    this.entryWave = 0;
    this.fullyUnlocked = !this.lockedAtStart;
    return this.reset();
  }

  reset() {
    this.x = this.home[0];
    this.y = this.home[1];
    this.vx = 0; this.vy = 0;
    this.inside = false; this.insideTime = 0; this.holdTime = 0; this.settled = false;
    this.glow = 0; this.pulse = 0; this.driftNow = 0; this.obstacleHitAt = -1;
    this.released = false; this.held = false; this.repelled = 0;
    this.latch = null;
    this.prevX = this.x; this.prevY = this.y;
  }

  isMovable() { return !this.locked; }

  // 轨迹偏移：正弦往返，周期与幅度由关卡配置固定，方向由 driftAngle 控制。
  // pause 模式在两端停留更久，形成可读的"窗口期"。
  trajectoryOffset(t) {
    if (this.driftMode === "none" || this.driftAmplitude <= 0) return [0, 0];
    if (t < this.driftStart) return [0, 0];
    const u = (t - this.driftStart) / this.driftPeriod;
    if (this.driftMode === "pause") {
      // 每周期分四段：去程 30%、端点停留 20%、回程 30%、端点停留 20%
      const k = ((u % 1) + 1) % 1;
      let s;
      if (k < 0.3) s = k / 0.3;
      else if (k < 0.5) s = 1;
      else if (k < 0.8) s = 1 - (k - 0.5) / 0.3;
      else s = -1;
      // 平滑端点附近的速度，避免"瞬间折返"的视觉跳变。
      // 注意：这里不能再叠加 driftPhase，否则端点停留会被相位偏移吃掉，
      // 实际振幅缩到只有配置值的 1/3。
      return this.rotateOffset(s);
    }
    // 普通往返：相位由关卡 seed 固定，保证不同关卡轨迹形态不同但完全可复现。
    // driftPhase 只作为小幅起始偏移，避免"配置 34px 实际只走 11px"的振幅缩水。
    const swing = Math.sin(u * TAU + this.driftPhase * 0.5);
    return this.rotateOffset(swing);
  }

  rotateOffset(s) {
    const ca = Math.cos(this.driftAngle), sa = Math.sin(this.driftAngle);
    const ox = this.driftAxis.x * this.driftAmplitude * s;
    const oy = this.driftAxis.y * this.driftAmplitude * s;
    return [ox * ca - oy * sa, ox * sa + oy * ca];
  }

  update(dt, t, core) {
    const startX = this.x, startY = this.y;

    // 预设轨迹：位置 = 固定起点 + 固定轨迹偏移。
    // 绝对定位而非速度积分，因此相同时间点必然得到相同位置。
    // 一旦被波纹推动过就彻底交给物理：轨迹只负责"推动前"的位置。
    // （中途接管轨迹会把已经被推走的碎片硬拉回轨迹线上，导致永远进不了光核。）
    if (this.driftMode !== "none" && !this.locked && !this.settled && !this.released) {
      const offset = this.trajectoryOffset(t);
      this.x = this.home[0] + offset[0];
      this.y = this.home[1] + offset[1];
    }

    if (!this.locked) {
      // 阻尼决定滑行距离：v0/k 即总位移。
      // k=1.9 时，弱波约滑 90px、强波约滑 300px，正好覆盖关卡的 150~240px 尺度。
      const drag = Math.exp(-1.9 * dt);
      this.vx *= drag;
      this.vy *= drag;

      this.x += this.vx * dt;
      this.y += this.vy * dt;

      // 边界（软反弹）
      const m = this.r + 6;
      if (this.x < m) { this.x = m; this.vx = Math.abs(this.vx) * 0.5; }
      if (this.x > W - m) { this.x = W - m; this.vx = -Math.abs(this.vx) * 0.5; }
      if (this.y < m) { this.y = m; this.vy = Math.abs(this.vy) * 0.5; }
      if (this.y > H - m) { this.y = H - m; this.vy = -Math.abs(this.vy) * 0.5; }
    }

    this.pulse = damp(this.pulse, 0, 5, dt);
    this.glow = damp(this.glow, 0, 3.2, dt);

    // 光圈判定：必须"进圈 + 慢下来"才算停稳。
    // 这一条给拖拽强度加上了上限——推得太猛会高速穿过光圈，停不下来。
    const d = Math.hypot(this.x - core.x, this.y - core.y);
    const wasInside = this.inside;
    // 判定环略大于可见光圈：只要最终停在光核边缘附近、速度足够低，
    // 就算收拢成功。避免"明明已经停下，却卡在光圈外几像素"的死局。
    const captureR = core.goalR * (core.captureScale || 1);
    this.inside = d < captureR - this.r * 0.35;

    // 本帧由位置差得出的真实位移速度。
    // 直接积分的 vx/vy 会比实际位移大（阻尼在位移前已经衰减），
    // 用它判断"是否慢下来"会让重目标永远达不到停稳门槛。
    const actualSpeed = dt > 0
      ? Math.hypot(this.x - startX, this.y - startY) / dt
      : 0;
    // 停稳门槛：随光圈大小放宽，避免小光圈关卡过于苛刻
    const settleSpeed = Math.max(core.goalR * (game.settleFactor || 0.42), 26) * SCALE;

    if (this.locked) {
      // 锁定碎片只有被对应波纹解锁后才能被收拢
      this.holdTime = 0;
    } else if (this.settled) {
      latchShard(this, dt);
      return;
    } else if (core.requireOrder !== null && core.requireOrder !== undefined
               && this.order > 0 && this.order !== core.requireOrder) {
      // 顺序未轮到：进圈不算完成
      this.holdTime = 0;
    } else {
      const slowEnough = actualSpeed < settleSpeed;
      if (this.inside && slowEnough) {
        const need = this.settleDuration || 0;
        if (need <= 0) {
          this.settled = true;
          this.latch = [this.x, this.y];
          this.holdTime = 0;
        } else {
          this.holdTime += dt;
          if (this.holdTime >= need) {
            this.settled = true;
            this.latch = [this.x, this.y];
          }
        }
        this.held = true;
      } else {
        this.holdTime = 0;
        this.held = false;
      }
    }

    if (this.inside && !wasInside) {
      this.glow = 1;
      Audio_.enter(Math.round(d / Math.max(core.goalR, 1) * 4), game.theme);
    }
    if (this.inside) this.insideTime += dt;
    else this.insideTime = 0;
  }

  // 被波纹扫过。返回 "unlocked" 或 "unlocked-pushed"。
  // 解锁与收拢可以在同一波里完成：波锋到达时先把碎片解锁，
  // 再让它以"从起点出发"的方式继续参与本波的推动计算。
  receiveWave(wave) {
    if (this.settled) return "settled";
    if (this.locked) {
      if (this.unlockOrder > 0 && wave.index !== this.unlockOrder) return "wrong-unlock";
      this.locked = false;
      this.fullyUnlocked = true;
      this.glow = 1;
      this.pulse = 1;
      // 解锁瞬间把它放回起点，避免它被解锁前的残余位置影响
      this.x = this.home[0];
      this.y = this.home[1];
      this.vx = 0;
      this.vy = 0;
      this.inside = false;
      this.insideTime = 0;
      return "unlocked-pushed";
    }
    return "pushed";
  }

  draw(t, th) {
    th = th || game.theme;
    const r = this.r * (1 + this.pulse * 0.22);

    // 光晕
    if (this.glow > 0.01 || this.inside) {
      const g = ctx.createRadialGradient(this.x, this.y, r * 0.4, this.x, this.y, r * 3.4);
      const a = 0.05 + this.glow * 0.24 + (this.inside ? 0.08 : 0);
      g.addColorStop(0, rgba(th.accentRGB, a));
      g.addColorStop(1, rgba(th.accentRGB, 0));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(this.x, this.y, r * 3.4, 0, TAU);
      ctx.fill();
    }

    const breathe = 1 + Math.sin(t * 1.6 + this.phase) * 0.02;
    const rr = r * breathe;

    ctx.save();
    ctx.translate(this.x, this.y);

    const bodyFill = this.settled
      ? rgba(th.accentRGB, 0.26)
      : (this.inside ? rgba(th.accentRGB, 0.10)
        : (this.locked ? "rgba(232, 184, 127, 0.10)" : rgba(th.inkRGB, 0.055)));
    const bodyLine = this.settled
      ? rgba(th.accentRGB, 0.98)
      : (this.inside ? rgba(th.accentRGB, 0.55)
        : (this.locked ? "rgba(232, 184, 127, 0.72)" : rgba(th.inkRGB, 0.62)));

    // 每个主题的碎片形态不同：小行星 / 游鱼 / 发光鱼 / 冰晶
    if (th.waveStyle === "ripple") {
      // 游鱼：水滴形身体 + 分叉尾鳍 + 背鳍
      const sway = Math.sin(t * 2.2 + this.phase) * 0.2;
      ctx.rotate(Math.sin(t * 0.4 + this.phase) * 0.1);

      // 身体（前圆后尖）
      ctx.beginPath();
      ctx.moveTo(rr * 1.28, 0);
      ctx.quadraticCurveTo(rr * 0.3, -rr * 0.86, -rr * 0.72, -rr * 0.3);
      ctx.quadraticCurveTo(-rr * 0.95, 0, -rr * 0.72, rr * 0.3);
      ctx.quadraticCurveTo(rr * 0.3, rr * 0.86, rr * 1.28, 0);
      ctx.closePath();
      ctx.fillStyle = bodyFill;
      ctx.fill();
      ctx.lineWidth = this.locked ? 1.6 : 1.1;
      ctx.strokeStyle = bodyLine;
      ctx.stroke();

      // 尾鳍：分两片
      const tailX = -rr * 0.78;
      ctx.beginPath();
      ctx.moveTo(tailX, 0);
      ctx.lineTo(-rr * 1.62, -rr * 0.72 + sway * rr * 1.6);
      ctx.lineTo(-rr * 1.28, 0);
      ctx.closePath();
      ctx.strokeStyle = rgba(th.accentRGB, this.inside ? 0.8 : 0.5);
      ctx.lineWidth = 0.9;
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(tailX, 0);
      ctx.lineTo(-rr * 1.62, rr * 0.72 + sway * rr * 1.6);
      ctx.lineTo(-rr * 1.28, 0);
      ctx.closePath();
      ctx.stroke();

      // 背鳍
      ctx.beginPath();
      ctx.moveTo(rr * 0.1, -rr * 0.72);
      ctx.quadraticCurveTo(-rr * 0.25, -rr * 1.35, -rr * 0.6, -rr * 0.5);
      ctx.strokeStyle = rgba(th.accentRGB, this.inside ? 0.7 : 0.4);
      ctx.lineWidth = 0.8;
      ctx.stroke();

      // 眼睛
      ctx.beginPath();
      ctx.arc(rr * 0.62, -rr * 0.16, rr * 0.15, 0, TAU);
      ctx.fillStyle = rgba(th.accentRGB, 0.9);
      ctx.fill();

    } else if (th.waveStyle === "sonar") {
      // 发光鱼：菱形身体 + 发光点
      ctx.rotate(Math.sin(t * 0.5 + this.phase) * 0.15);
      ctx.beginPath();
      ctx.moveTo(rr * 1.25, 0);
      ctx.lineTo(0, -rr * 0.92);
      ctx.lineTo(-rr * 1.1, 0);
      ctx.lineTo(0, rr * 0.92);
      ctx.closePath();
      ctx.fillStyle = bodyFill;
      ctx.fill();
      ctx.lineWidth = this.locked ? 1.6 : 1.15;
      ctx.strokeStyle = bodyLine;
      ctx.stroke();

      const glowPulse = 0.5 + 0.5 * Math.sin(t * 2.6 + this.phase);
      ctx.beginPath();
      ctx.arc(rr * 0.35, 0, rr * 0.22 * (0.8 + glowPulse * 0.4), 0, TAU);
      ctx.fillStyle = rgba(th.accentRGB, 0.55 + glowPulse * 0.4);
      ctx.fill();

    } else if (th.waveStyle === "aurora") {
      // 冰晶：六角形
      ctx.rotate(t * 0.25 + this.phase);
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const a = (i / 6) * TAU - Math.PI / 2;
        const px = Math.cos(a) * rr * 1.12;
        const py = Math.sin(a) * rr * 1.12;
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = bodyFill;
      ctx.fill();
      ctx.lineWidth = this.locked ? 1.6 : 1.1;
      ctx.strokeStyle = bodyLine;
      ctx.stroke();

      // 内部折射线
      for (let i = 0; i < 3; i++) {
        const a = (i / 3) * Math.PI;
        ctx.beginPath();
        ctx.moveTo(Math.cos(a) * rr * 0.95, Math.sin(a) * rr * 0.95);
        ctx.lineTo(-Math.cos(a) * rr * 0.95, -Math.sin(a) * rr * 0.95);
        ctx.strokeStyle = rgba(th.accentRGB, 0.28);
        ctx.lineWidth = 0.7;
        ctx.stroke();
      }

    } else if (th.waveStyle === "dust") {
      // 沙砾：粗糙的多面颗粒
      ctx.rotate(t * 0.3 + this.phase);
      ctx.beginPath();
      for (let i = 0; i < 5; i++) {
        const a = (i / 5) * TAU - Math.PI / 2;
        const wob = 1 + Math.sin(i * 3.1 + this.phase) * 0.24;
        const px = Math.cos(a) * rr * wob, py = Math.sin(a) * rr * wob;
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = bodyFill;
      ctx.fill();
      ctx.lineWidth = this.locked ? 1.6 : 1.1;
      ctx.strokeStyle = bodyLine;
      ctx.stroke();
      // 高光棱面
      ctx.beginPath();
      ctx.moveTo(0, -rr * 0.5);
      ctx.lineTo(rr * 0.45, 0);
      ctx.lineTo(0, rr * 0.4);
      ctx.closePath();
      ctx.strokeStyle = rgba(th.accentRGB, 0.3);
      ctx.lineWidth = 0.7;
      ctx.stroke();

    } else if (th.waveStyle === "pollen") {
      // 萤火：小光球带轻微上下浮动
      const flick = 0.55 + 0.45 * Math.sin(t * 2.4 + this.phase);
      const g = ctx.createRadialGradient(0, 0, 0, 0, 0, rr * 2.6);
      g.addColorStop(0, rgba(th.accentRGB, 0.5 + flick * 0.4));
      g.addColorStop(0.45, rgba(th.accentRGB, 0.14));
      g.addColorStop(1, rgba(th.accentRGB, 0));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(0, 0, rr * 2.6, 0, TAU);
      ctx.fill();

      ctx.beginPath();
      ctx.arc(0, 0, rr * 0.82, 0, TAU);
      ctx.fillStyle = rgba(th.accentRGB, 0.5 + flick * 0.35);
      ctx.fill();
      ctx.strokeStyle = bodyLine;
      ctx.lineWidth = this.locked ? 1.5 : 1;
      ctx.stroke();

      // 小翅膀
      ctx.beginPath();
      ctx.ellipse(-rr * 0.7, -rr * 0.25, rr * 0.5, rr * 0.26, -0.5, 0, TAU);
      ctx.ellipse(rr * 0.7, -rr * 0.25, rr * 0.5, rr * 0.26, 0.5, 0, TAU);
      ctx.strokeStyle = rgba(th.inkRGB, 0.35);
      ctx.lineWidth = 0.7;
      ctx.stroke();

    } else if (th.waveStyle === "chill") {
      // 雪块：带切面的圆润冰块
      ctx.rotate(Math.sin(t * 0.35 + this.phase) * 0.2);
      ctx.beginPath();
      ctx.moveTo(-rr * 0.9, -rr * 0.55);
      ctx.quadraticCurveTo(0, -rr * 1.12, rr * 0.95, -rr * 0.45);
      ctx.quadraticCurveTo(rr * 1.15, rr * 0.35, rr * 0.1, rr * 0.95);
      ctx.quadraticCurveTo(-rr * 0.95, rr * 0.75, -rr * 1.0, -rr * 0.1);
      ctx.closePath();
      ctx.fillStyle = bodyFill;
      ctx.fill();
      ctx.lineWidth = this.locked ? 1.6 : 1.15;
      ctx.strokeStyle = bodyLine;
      ctx.stroke();

      // 内部裂纹
      ctx.beginPath();
      ctx.moveTo(-rr * 0.5, -rr * 0.3);
      ctx.lineTo(rr * 0.1, rr * 0.1);
      ctx.lineTo(-rr * 0.2, rr * 0.5);
      ctx.strokeStyle = rgba(th.accentRGB, 0.35);
      ctx.lineWidth = 0.7;
      ctx.stroke();

    } else if (th.waveStyle === "ember") {
      // 炭块：方形焦块 + 内部余烬纹
      ctx.rotate(Math.sin(t * 0.4 + this.phase) * 0.16 + this.phase * 0.5);
      const s2 = rr * 0.82;
      ctx.beginPath();
      ctx.moveTo(-s2, -s2 * 0.85);
      ctx.lineTo(s2 * 0.7, -s2);
      ctx.lineTo(s2, s2 * 0.6);
      ctx.lineTo(-s2 * 0.5, s2 * 0.95);
      ctx.lineTo(-s2, s2 * 0.2);
      ctx.closePath();
      // 焦块本身用深色填充，比背景略亮一点，避免在暖色底上发白
      ctx.fillStyle = this.settled
        ? rgba(th.accentRGB, 0.3)
        : (this.inside ? rgba(th.accentRGB, 0.14) : "rgba(28,14,10,0.85)");
      ctx.fill();
      ctx.lineWidth = this.locked ? 1.6 : 1.15;
      ctx.strokeStyle = this.settled
        ? rgba(th.accentRGB, 0.98)
        : (this.locked ? "rgba(232, 184, 127, 0.72)" : rgba(th.accentRGB, 0.55));
      ctx.stroke();

      // 裂缝里的火光
      const heat = 0.4 + 0.6 * (0.5 + 0.5 * Math.sin(t * 3.4 + this.phase));
      ctx.beginPath();
      ctx.moveTo(-s2 * 0.45, -s2 * 0.4);
      ctx.lineTo(s2 * 0.1, 0);
      ctx.lineTo(-s2 * 0.15, s2 * 0.55);
      ctx.strokeStyle = rgba(th.accentRGB, 0.45 + heat * 0.5);
      ctx.lineWidth = 1;
      ctx.stroke();

    } else {
      // 小行星：不规则多边形
      ctx.rotate(Math.sin(t * 0.4 + this.phase) * 0.14 + this.phase);
      ctx.beginPath();
      const verts = 7;
      for (let i = 0; i < verts; i++) {
        const a = (i / verts) * TAU;
        const wob = 1 + Math.sin(i * 2.7 + this.phase) * 0.18;
        const px = Math.cos(a) * rr * wob;
        const py = Math.sin(a) * rr * wob;
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = bodyFill;
      ctx.fill();
      ctx.lineWidth = this.locked ? 1.6 : 1.15;
      ctx.strokeStyle = bodyLine;
      ctx.stroke();

      // 陨石坑
      ctx.beginPath();
      ctx.arc(-rr * 0.28, -rr * 0.2, rr * 0.2, 0, TAU);
      ctx.strokeStyle = rgba(th.inkRGB, 0.22);
      ctx.lineWidth = 0.7;
      ctx.stroke();
    }

    // 锁定标记：十字
    if (this.locked) {
      ctx.beginPath();
      ctx.moveTo(-rr * 0.75, 0); ctx.lineTo(rr * 0.75, 0);
      ctx.moveTo(0, -rr * 0.75); ctx.lineTo(0, rr * 0.75);
      ctx.strokeStyle = "rgba(232, 184, 127, 0.35)";
      ctx.lineWidth = 0.7;
      ctx.stroke();
    }

    ctx.restore();
  }
}

class Wave {
  constructor(x, y, strength, index) {
    this.x = x;
    this.y = y;
    this.r = 6 * SCALE;
    this.prevR = this.r;
    this.strength = strength;
    this.index = index || 1;     // 本关第几道波纹（用于锁定碎片的解锁顺序）
    // 强波：更快、更远、推动更强；弱波：柔和短促
    this.speed = lerp(200, 430, strength) * SCALE;
    // 范围贴合关卡尺度（碎片最远约 210px），避免波纹铺满整屏失去层次
    this.maxR = lerp(250, 560, strength) * SCALE;
    this.life = 0;
    this.hit = new Set();
  }

  update(dt) {
    this.prevR = this.r;
    // 波在扩散中轻微减速
    const progress = clamp(this.r / this.maxR, 0, 1);
    const decel = lerp(1, 0.6, progress);
    this.r += this.speed * decel * dt;
    this.life += dt;
    return this.r < this.maxR;
  }

  // 波锋扫过碎片时施加一次冲量。
  // 用 prevR→r 的扫掠区间判断是否在这一帧穿过碎片，避免漏检也避免重复施加。
  // 方向：把碎片朝波源（核）收拢，波像引力涟漪一样把碎片带向中心。
  apply(shard, coreX, coreY, game_) {
    // 已停稳的目标不再参与后续波纹的推动
    if (shard.settled) return "settled";
    if (this.hit.has(shard)) return;

    const dx = shard.x - this.x;
    const dy = shard.y - this.y;
    const d = Math.hypot(dx, dy) || 0.001;

    // 这一帧波锋扫过的半径区间是否经过碎片
    const reached = d <= this.r;
    const notPassed = d >= this.prevR - shard.r;
    if (!reached) return;              // 波还没到

    this.hit.add(shard);
    if (!notPassed) return;            // 已经被更早的波锋越过，不再施加

    // 危险区：碎片停在危险扇区内时，这一波不能把它收拢，
    // 而是把它从扇区里推开一点（温和惩罚，不会造成死局）。
    // 玩家需要先把目标"清出"危险区，再用下一波收拢。
    if (game_ && game_.obstacles && inObstacle(game_, shard, coreX, coreY)) {
      shard.repelled = (shard.repelled || 0) + 1;
      shard.pulse = Math.min(1, shard.pulse + 0.6);
      const ox = shard.x - coreX, oy = shard.y - coreY;
      const od = Math.hypot(ox, oy) || 1;
      // 沿径向外推，把它带出扇区外缘
      const push = lerp(26, 46, this.strength) * SCALE;
      shard.x += (ox / od) * push;
      shard.y += (oy / od) * push;
      shard.released = true;
      shard.settled = false;
      return "obstacle";
    }

    if (shard.locked) {
      const verdict = shard.receiveWave(this);
      // 解锁后立刻用同一波把碎片推向光核：
      // 这样"先解锁、再收拢"是同一波里的一次连锁，而不是等下一波（下一波只会把它推过头）。
      if (verdict !== "unlocked-pushed") return verdict;
    }

    shard.released = true;
    shard.locked = false;
    // 命中位置决定力度：波锋正切碎片中心时最强
    const ideal = Math.abs(d - (this.prevR + this.r) / 2);
    const band = shard.r + 10 * SCALE;
    const falloff = clamp(1 - ideal / band, 0.15, 1);
    // 波扩散越远越弱（衰减比原来更平缓，保证外圈目标有可用的力度窗口）
    const rangeFalloff = 1 - clamp(this.r / this.maxR, 0, 1) * 0.24;
    // 拖得越长越强：滑行距离约 60px(弱) ~ 230px(强)
    const power = lerp(170, 560, this.strength) * SCALE;

    const impulse = falloff * rangeFalloff * power / shard.mass;

    // 指向核
    let tx = coreX - shard.x;
    let ty = coreY - shard.y;
    const td = Math.hypot(tx, ty) || 0.001;

    shard.vx += (tx / td) * impulse;
    shard.vy += (ty / td) * impulse;
    shard.released = true;
    shard.pulse = Math.min(1, shard.pulse + 0.3 + this.strength * 0.45);
    return shard.entryWave ? "unlocked-pushed" : "pushed";
  }

  draw(alpha, th) {
    th = th || game.theme;
    const p = this.r / this.maxR;
    const a = (1 - p) * (0.16 + this.strength * 0.42) * alpha;
    const style = th.waveStyle;

    // 主波锋
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.r, 0, TAU);
    ctx.lineWidth = lerp(2.6, 1.0, p) * SCALE;
    ctx.strokeStyle = rgba(th.accentRGB, clamp(a, 0, 0.8));
    ctx.stroke();

    if (style === "ripple") {
      // 水波：外侧再叠两层同心细环，随主环一起衰减、逐渐散开
      for (let i = 1; i <= 2; i++) {
        const rr = this.r - i * 7 * SCALE;
        if (rr <= 0) continue;
        // 越往外越淡、越细，避免形成"靶环"感
        ctx.beginPath();
        ctx.arc(this.x, this.y, rr, 0, TAU);
        ctx.lineWidth = lerp(1.2, 0.4, p) * SCALE;
        ctx.strokeStyle = rgba(th.accentRGB, clamp(a * (0.34 - i * 0.11), 0, 0.3));
        ctx.stroke();
      }
    } else if (style === "sonar") {
      // 声呐：断续的弧段，带扫描感
      const segs = 10;
      for (let i = 0; i < segs; i++) {
        if (i % 2) continue;
        const a0 = (i / segs) * TAU + this.life * 0.6;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.r * (0.97 + (i % 3) * 0.012), a0, a0 + TAU / segs * 0.8);
        ctx.lineWidth = lerp(2.2, 0.9, p) * SCALE;
        ctx.strokeStyle = rgba(th.accentRGB, clamp(a * 1.1, 0, 0.75));
        ctx.stroke();
      }
    } else if (style === "aurora") {
      // 极光：主环外再画一条略微偏移的柔和彩环
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r * 1.03, 0, TAU);
      ctx.lineWidth = 6 * SCALE;
      ctx.strokeStyle = rgba(th.accentRGB, clamp(a * 0.22, 0, 0.22));
      ctx.stroke();
    } else if (style === "dust") {
      // 风沙：主环外侧散布颗粒，形成被吹起的沙尘
      for (let i = 0; i < 14; i++) {
        const ang = (i / 14) * TAU + this.life * 0.35;
        const jitter = (0.94 + ((i * 37) % 11) / 90);
        const px = this.x + Math.cos(ang) * this.r * jitter;
        const py = this.y + Math.sin(ang) * this.r * jitter;
        ctx.beginPath();
        ctx.arc(px, py, (1 + ((i * 13) % 5) * 0.35) * SCALE, 0, TAU);
        ctx.fillStyle = rgba(th.accentRGB, clamp(a * 0.5, 0, 0.4));
        ctx.fill();
      }
    } else if (style === "pollen") {
      // 花粉：断续的小点沿环飘散，像光尘被推开
      const dots = 26;
      for (let i = 0; i < dots; i++) {
        if (i % 3 === 1) continue;
        const ang = (i / dots) * TAU;
        const rr = this.r * (1 + 0.03 * Math.sin(this.life * 3 + i));
        ctx.beginPath();
        ctx.arc(this.x + Math.cos(ang) * rr, this.y + Math.sin(ang) * rr,
                1.5 * SCALE, 0, TAU);
        ctx.fillStyle = rgba(th.accentRGB, clamp(a * 0.75, 0, 0.55));
        ctx.fill();
      }
    } else if (style === "chill") {
      // 寒潮：主环加一圈细碎的冰晶点
      for (let i = 0; i < 16; i++) {
        const ang = (i / 16) * TAU + this.life * 0.2;
        const px = this.x + Math.cos(ang) * this.r * 1.02;
        const py = this.y + Math.sin(ang) * this.r * 1.02;
        ctx.beginPath();
        for (let k = 0; k < 3; k++) {
          const aa = ang + k * Math.PI / 3;
          ctx.moveTo(px - Math.cos(aa) * 3 * SCALE, py - Math.sin(aa) * 3 * SCALE);
          ctx.lineTo(px + Math.cos(aa) * 3 * SCALE, py + Math.sin(aa) * 3 * SCALE);
        }
        ctx.strokeStyle = rgba(th.accentRGB, clamp(a * 0.5, 0, 0.32));
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }
    } else if (style === "ember") {
      // 炽焰：主环偏粗且带热浪抖动
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r * 1.01, 0, TAU);
      ctx.lineWidth = lerp(7, 3, p) * SCALE;
      ctx.strokeStyle = rgba(th.accentRGB, clamp(a * 0.34, 0, 0.3));
      ctx.stroke();

      for (let i = 0; i < 18; i++) {
        const ang = (i / 18) * TAU + Math.sin(this.life * 2 + i) * 0.06;
        const rr = this.r * (0.96 + 0.09 * Math.sin(this.life * 4 + i * 1.7));
        ctx.beginPath();
        ctx.arc(this.x + Math.cos(ang) * rr, this.y + Math.sin(ang) * rr,
                2.2 * SCALE, 0, TAU);
        ctx.fillStyle = rgba(th.accentRGB, clamp(a * 0.7, 0, 0.5));
        ctx.fill();
      }
    } else {
      // 星河：主环带一层雾状拖尾
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r * 0.99, 0, TAU);
      ctx.lineWidth = 7 * SCALE;
      ctx.strokeStyle = rgba(th.accentRGB, clamp(a * 0.14, 0, 0.18));
      ctx.stroke();
    }

    // 内侧薄雾，让波更有体积感
    if (p < 0.85) {
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r * 0.94, 0, TAU);
      ctx.lineWidth = 5 * SCALE;
      ctx.strokeStyle = rgba(th.accentRGB, clamp(a * 0.16, 0, 0.2));
      ctx.stroke();
    }
  }
}

