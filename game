    </svg>
  </button>
  <button class="icon-btn" id="menuBtn" title="返回选关 (Esc)" aria-label="返回选关">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
  </button>
  <button class="icon-btn" id="resetBtn" title="重置本关 (R)" aria-label="重置本关">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
