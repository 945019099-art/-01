/* ------------------ 关卡选择与进度 ------------------ */
function isUnlocked(i) { return i < progress.unlocked; }
function isCleared(i) { return progress.cleared.includes(i); }

function renderLives(container) {
  container.innerHTML = "";
  for (let i = 0; i < 3; i++) {
    const el = document.createElement("i");
    if (i >= progress.lives) el.className = "gone";
    container.appendChild(el);
  }
}

function renderSelect() {
  levelGrid.innerHTML = "";
  LEVELS.forEach((cfg, i) => {
    const theme = THEMES[cfg.theme] || THEMES.space;
    const unlocked = isUnlocked(i);
    const cleared = isCleared(i);

    const el = document.createElement("button");
    el.className = "lv" + (unlocked ? "" : " locked") +
      (cleared ? " cleared" : "") +
      (i === progress.lastLevel && unlocked ? " current" : "");
    el.disabled = !unlocked;
    el.innerHTML =
      `<span class="lv-num">${String(i + 1).padStart(2, "0")}</span>` +
      `<span class="lv-name">${cfg.name}</span>` +
      `<span class="lv-theme">${theme.label}</span>` +
      (cleared ? `<span class="lv-mark">&#10003;</span>` : "");

    if (unlocked) {
      el.addEventListener("click", () => {
        selectScreen.classList.remove("show");
        game.started = true;
        Audio_.resume();
        loadLevel(i, false);
      });
    }
    levelGrid.appendChild(el);
  });

  const total = LEVELS.length;
  const done = progress.cleared.length;
  selectSub.textContent = done >= total
    ? `全部 ${total} 个世界已归于平静。`
    : `已完成 ${done} / ${total} · 每过一关解锁下一个世界`;

  renderLives(selectLives);
  selectLives.appendChild(Object.assign(document.createElement("span"), {
    textContent: `生命 ${progress.lives} / 3`,
  }));

  const nextIdx = clamp(progress.unlocked - 1, 0, LEVELS.length - 1);
  continueBtn.textContent = progress.cleared.length === 0 ? "开始" : "继续";
  continueBtn.dataset.target = String(nextIdx);
}

function openSelect() {
  game.started = false;
  game.dragging = false;
  game.pointerDown = false;
  game.dragId = null;
  game.dragMaxDist = 0;
  Audio_.endDrag();
  hideOverlay();
  renderSelect();
  selectScreen.classList.add("show");
}

// 释放波时检查预算
function consumeWave() {
  if (game.waveBudget <= 0) return false;
  game.waveBudget--;
  updateWaveHud();
  return true;
}

function updateWaveHud() {
  waveTextEl.textContent = `${game.waveBudget} / ${game.waveBudgetMax}`;
  waveCounterEl.classList.toggle("empty", game.waveBudget === 0);
  waveCounterEl.classList.toggle("low", game.waveBudget === 1 && game.waveBudgetMax > 1);
}

function updateLives() {
  renderLives(livesEl);
}

function buildRail() {
  railEl.innerHTML = "";
  LEVELS.forEach(() => {
    const i = document.createElement("i");
    railEl.appendChild(i);
  });
}
buildRail();

function updateRail() {
  [...railEl.children].forEach((el, i) => {
    el.className = i < game.index ? "done" : (i === game.index ? "now" : "");
  });
}

function placeLevel(cfg) {
  CX = W * cfg.core[0];
  CY = H * cfg.core[1];
  game.theme = THEMES[cfg.theme] || THEMES.space;
  game.maxWaves = cfg.simultaneousWaves || 3;
  game.interference = !!cfg.interference;
  game.settleFactor = cfg.settleFactor || 0.42;
  game.note = cfg.note || {};
  game.seed = cfg.seed || (3100 + game.index + 1);
  game.particleRnd = seeded(game.seed * 104729 + 17);
  game.obstacles = (cfg.obstacles || []).map(o => ({
    angle: (o.angle || 0) * Math.PI / 180,
    width: (o.width || 30) * Math.PI / 180,
    // inner/outer 是"光圈半径的倍数"，因此要乘 goalRadius()。
    // 直接乘 SCALE 会让所有扇区内径都变成 0，等于障碍形状完全失效。
    inner: (o.inner != null ? o.inner : 0.4) * goalRadius(),
    outer: (o.outer != null ? o.outer : 1.2) * goalRadius(),
    strength: o.strength || 0,
  }));
  game.waveGapMin = cfg.waveGap ? cfg.waveGap[0] : 0;
  game.waveGapMax = cfg.waveGap ? cfg.waveGap[1] : 0;
  game.captureScale = cfg.captureScale || 1.12;
  game.waveIndex = 0;
  game.lastWaveAt = 0;
  game.failReason = "";

  game.shards = cfg.shards.map((s, i) => new Shard(s, i, game.seed));
  syncOrderState(true);

  // 双拍 / 顺序机制：只有明确配置时才允许多次发射；
  // 否则第二波会变成"万能补救"，把关卡难度和顺序约束一起抹平。
  game.multiWave = !!cfg.multiWave;
  // 波数限制：cfg.waveBudget 表示本关总共能放几次
  game.waveBudgetMax = game.multiWave ? (cfg.waveBudget || 2) : 1;
  game.waveBudget = game.waveBudgetMax;
  game.waveLimitReached = false;
  applyTheme(game.theme);
}

// 顺序目标：维护"当前应该处理第几号目标"。
// 只统计尚未完成的目标，全部完成的小组会自动推进到下一号。
function syncOrderState(force) {
  const groups = [...new Set(game.shards.map(s => s.order).filter(n => n > 0))].sort((a, b) => a - b);
  if (!groups.length) {
    game.requireOrder = null;
    game.orderActive = false;
    return;
  }
  game.orderActive = true;
  let required = groups[groups.length - 1];
  for (const g of groups) {
    const pending = game.shards.some(s => s.order === g && !s.settled);
    if (pending) { required = g; break; }
  }
  if (force || game.requireOrder !== required) game.requireOrder = required;
}

// 危险区判定：碎片是否落在某个障碍扇区内
function inObstacle(g, shard, coreX, coreY) {
  if (!g.obstacles || !g.obstacles.length) return false;
  const dx = shard.x - coreX, dy = shard.y - coreY;
  const d = Math.hypot(dx, dy);
  if (d <= 0.001) return false;
  const a = Math.atan2(dy, dx);
  for (const o of g.obstacles) {
    if (d < o.inner || d > o.outer) continue;
    let diff = Math.abs(((a - o.angle + Math.PI * 3) % (Math.PI * 2)) - Math.PI);
    if (diff <= o.width / 2) return true;
  }
  return false;
}

// 把主题配色写进 CSS 变量，让 HUD 与画布保持一致
function applyTheme(theme) {
  const root = document.documentElement.style;
  root.setProperty("--bg", theme.bg);
  root.setProperty("--bg-deep", theme.bgDeep);
  root.setProperty("--ink", theme.ink);
  root.setProperty("--accent", theme.accent);
  root.setProperty("--accent-soft", theme.accentSoft);
}

function loadLevel(i, quiet) {
  game.index = clamp(i, 0, LEVELS.length - 1);
  const cfg = LEVELS[game.index];

  placeLevel(cfg);

  game.waves.length = 0;
  game.particles.length = 0;
  game.solved = false;
  game.solvedTimer = 0;
  game.completeDelay = 0;
  game.dragging = false;
  game.pointerDown = false;
  game.dragId = null;
  game.dragMaxDist = 0;
  Audio_.endDrag();
  game.strength = 0;
  game.failed = false;
  game.failCheckAt = 0;
  // 载入关卡即进入可操作状态。之前失败流程会把 started 置 false，
  // 若这里不恢复，点「重试本关」后鼠标会完全失效。
  game.started = true;

  progress.lastLevel = game.index;
  saveProgress();

  levelNameEl.textContent = cfg.name;
  hideOverlay();
  updateRail();
  updateCounter();
  updateWaveHud();
  setHint(cfg.note ? cfg.note : "按住并向外拖动，松手释放" + themeWord(cfg, "wave"));

  if (!quiet) {
    // 入场：所有碎片从核中心轻轻散开
    game.shards.forEach(s => {
      s.resetToStart();
      const sx = s.home[0], sy = s.home[1];
      const dx = sx - CX, dy = sy - CY;
      const d = Math.hypot(dx, dy) || 1;
      s.x = CX + dx / d * 40;
      s.y = CY + dy / d * 40;
      s.vx = dx / d * (d * 1.4);
      s.vy = dy / d * (d * 1.4);
    });
    syncOrderState(true);
  }
}

function themeWord(cfg, kind) {
  const t = THEMES[cfg.theme] || THEMES.space;
  if (kind === "wave") {
    const names = {
      ripple: "波纹", sonar: "声呐", aurora: "极光",
      dust: "风沙", pollen: "光尘", chill: "寒潮", ember: "震波",
      nebula: "星河",
    };
    return names[t.waveStyle] || "波纹";
  }
  return t.shardName;
}

function setHint(text) {
  hintEl.textContent = text;
}

function updateCounter() {
  const total = game.shards.length;
  const n = game.shards.filter(s => s.settled).length;
  counterText.textContent = `${n} / ${total}`;
  // 空关卡不算完成：没有碎片时 0 === 0 会造成"开局即通关"的误判
  const complete = total > 0 && n === total;
  counterEl.classList.toggle("full", complete);
  return complete;
}

/* ------------------ 覆盖层 ------------------ */
function showOverlay(label, title, desc, buttons) {
  ovLabel.textContent = label;
  ovTitle.textContent = title;
  ovDesc.innerHTML = desc;
  ovActions.innerHTML = "";
  buttons.forEach((b, i) => {
    const el = document.createElement("button");
    el.className = "btn" + (b.primary ? " primary" : "");
    if (i === 0) el.id = "ovPrimary";   // 主按钮保持稳定 id
    el.textContent = b.text;
    el.addEventListener("click", b.onClick);
    ovActions.appendChild(el);
  });
  overlay.classList.add("show");
}

function hideOverlay() {
  overlay.classList.remove("show");
}

/* ------------------ 输入 ------------------ */
function pointerPos(e) {
  const r = canvas.getBoundingClientRect();
  return [e.clientX - r.left, e.clientY - r.top];
}

canvas.addEventListener("pointerdown", e => {
  if (!game.started || game.solved || game.failed) return;
  if (e.button !== 0) return;
  // 记录鼠标物理按下状态：即使这次按下不允许起拖（比如没波纹了），
  // 也要保证按住期间不做失败结算。
  game.pointerDown = true;
  // 没有剩余波纹时不允许起手拖拽：否则玩家会拖到一半就被判定失败
  if (game.waveBudget <= 0) {
    setHint("波纹已用完");
    return;
  }
  Audio_.resume();
  const [x, y] = pointerPos(e);

  // 点击容错：从核附近按下即可开始拖拽（而不必精确点在几像素的核上）
  const pressDist = Math.hypot(x - CX, y - CY);
  const tolerantR = Math.max(goalRadius() * 1.6, 64);
  if (pressDist > tolerantR) return;

  game.dragging = true;
  game.dragFrom = [x, y];
  game.dragTo = [x, y];
  game.dragMaxDist = 0;      // 记录真实拖动距离，用于区分"点击"和"拖拽"
  game.dragId = e.pointerId;
  game.strength = 0;
  Audio_.beginDrag();
  // 指针捕获在触摸设备上可能抛异常（没有活动指针时），不能让它中断后续状态
  try {
    canvas.setPointerCapture(e.pointerId);
  } catch (err) { /* 忽略：不影响拖拽逻辑 */ }
});

canvas.addEventListener("pointermove", e => {
  if (!game.dragging) return;
  // 多指触摸时只跟随发起拖拽的那根手指
  if (game.dragId !== null && e.pointerId !== game.dragId) return;
  const [x, y] = pointerPos(e);
  game.dragTo = [x, y];
  // 记录从按下点算起的真实拖动距离
  const moved = Math.hypot(x - game.dragFrom[0], y - game.dragFrom[1]);
  if (moved > game.dragMaxDist) game.dragMaxDist = moved;
  // 强度按"离核的距离"计算，而不是按按下点算，
  // 这样无论从哪里起拖，同样的拖拽长度都得到同样的强度。
  const d = Math.hypot(x - CX, y - CY);
  game.strength = clamp((d - 18) / 200, 0.06, 1);
  Audio_.updateDrag(game.strength);
});

function releaseWave(e) {
  // 松开非拖拽的那根手指时忽略
  if (e && game.dragId !== null && e.pointerId !== game.dragId) return;
  if (!game.dragging) {
    game.pointerDown = false;
    return;
  }
  game.dragging = false;
  game.dragId = null;
  Audio_.endDrag();

  // 点击不算一次操作：必须是真实的拖拽动作才会释放波纹。
  // 之前只判断强度，导致光标停在远处时轻点一下也会消耗次数。
  const MIN_DRAG = 16 * Math.max(SCALE, 0.6);
  if (game.dragMaxDist < MIN_DRAG) {
    game.strength = 0;
    return;
  }
  // 力度下限：太轻的一下推不动任何目标。
  // 没有这个下限，玩家可以用"几乎为零的第二波"把残余目标免费蹭进光核。
  if (game.strength < MIN_WAVE_STRENGTH) {
    game.strength = 0;
    setHint("力度太轻，波纹推不动目标");
    return;
  }

  // 波数限制：没次数了就不允许再放
  if (!consumeWave()) {
    setHint("波纹已用完");
    game.strength = 0;
    return;
  }

  // 双波纹节奏：超过窗口上限后无法再发射（必须重新开始本关）
  if (game.waveIndex >= 1 && game.waveGapMax > 0) {
    const gap = game.time - game.lastWaveAt;
    if (gap > game.waveGapMax) {
      // 已经错过窗口，这次拖拽不消耗波纹
      game.waveBudget++;
      updateWaveHud();
      game.failReason = "波纹间隔过长，错过了节奏窗口";
      setHint("间隔过长，第二次波纹必须更早释放");
      game.strength = 0;
      return;
    }
  }

  if (game.waves.length >= game.maxWaves) {
    // 同时存在的波太多时，最老的一圈自然消散
    game.waves.shift();
  }

  game.waveIndex++;
  game.lastWaveAt = game.time;
  const w = new Wave(CX, CY, game.strength, game.waveIndex);
  game.waves.push(w);
  Audio_.wave(game.strength, game.theme);

  // 释放粒子（确定性视觉，不参与判定）
  const n = Math.floor(lerp(10, 30, game.strength));
  const rnd = game.particleRnd;
  for (let i = 0; i < n; i++) {
    const a = rnd() * TAU;
    const sp = lerp(40, 190, rnd()) * SCALE * (0.4 + game.strength);
    game.particles.push({
      x: CX + Math.cos(a) * 26 * SCALE,
      y: CY + Math.sin(a) * 26 * SCALE,
      vx: Math.cos(a) * sp,
      vy: Math.sin(a) * sp,
      life: 1,
      r: lerp(0.8, 2.1, rnd()) * SCALE,
    });
  }

  game.strength = 0;

  // 用完最后一次后不立刻倒计时，改成等物理真正停下来再判定。
  // 固定 2.6s 会在碎片还在滑行时就把玩家判负，手感很突兀。
  if (game.waveBudget === 0) {
    game.failCheckAt = -1;   // -1 = 等待运动停止
  }
}

canvas.addEventListener("pointerup", e => {
  game.pointerDown = false;
  releaseWave(e);
});
canvas.addEventListener("pointercancel", () => {
  game.pointerDown = false;
  game.dragging = false;
  game.dragId = null;
  Audio_.endDrag();
  game.strength = 0;
});

// 安全网：在画布外松手、窗口失焦、切到后台时清理拖拽状态。
// 否则 pointerDown 会一直留着，导致之后再也拖不动。
window.addEventListener("pointerup", e => {
  if (e.target === canvas) return;   // 画布上的已由上面的监听处理
  game.pointerDown = false;
  if (game.dragging) {
    game.dragging = false;
    game.dragId = null;
    Audio_.endDrag();
    game.strength = 0;
  }
});
function clearPointerState() {
  game.pointerDown = false;
  game.dragging = false;
  game.dragId = null;
  Audio_.endDrag();
  game.strength = 0;
}
window.addEventListener("blur", clearPointerState);
document.addEventListener("visibilitychange", () => {
  if (document.hidden) clearPointerState();
});

window.addEventListener("keydown", e => {
  // 选关界面打开时，只响应 Esc 返回
  if (selectScreen.classList.contains("show")) {
    if (e.key === "Escape") selectScreen.classList.remove("show");
    return;
  }
  if (e.key === "r" || e.key === "R") { if (game.started) loadLevel(game.index, true); }
  if (e.key === "m" || e.key === "M") toggleSound();
  if (e.key === "Escape") {
    if (overlay.classList.contains("show") && game.started) hideOverlay();
    else if (game.started) openSelect();
  }
});

/* ------------------ 按钮 ------------------ */
document.getElementById("resetBtn").addEventListener("click", () => {
  // 按住 R / 重置按钮会重新开始本关，并恢复波纹次数
  if (game.started) loadLevel(game.index, false);
});

const soundBtn = document.getElementById("soundBtn");
const waveA = document.getElementById("waveA");
const waveB = document.getElementById("waveB");

function toggleSound() {
  Audio_.enabled = !Audio_.enabled;
  Audio_.init();
  if (Audio_.enabled) Audio_.resume();
  waveA.style.opacity = Audio_.enabled ? "1" : "0.25";
  waveB.style.opacity = Audio_.enabled ? "1" : "0.25";
  soundBtn.style.color = Audio_.enabled ? "" : "#2c333c";
}
soundBtn.addEventListener("click", toggleSound);

/* ------------------ 主循环 ------------------ */
// 统一判定时钟：物理固定 1/60 秒步长，视觉照常按真实帧率渲染。
// 切后台或掉帧时不会出现"碎片瞬移"，判定结果与设备性能无关。
const STEP = 1 / 60;
const MAX_STEPS_PER_FRAME = 8;
let last = performance.now();
let accumulator = 0;
let lastNow = 0;

function frame(now) {
  const rawDt = Math.min((now - last) / 1000, 0.5);
  last = now;
  lastNow = now;
  accumulator += rawDt;

  let steps = 0;
  while (accumulator >= STEP && steps < MAX_STEPS_PER_FRAME) {
    game.time += STEP;
    update(STEP);
    accumulator -= STEP;
    steps++;
  }
  if (steps === MAX_STEPS_PER_FRAME) accumulator = 0;

  render();
  requestAnimationFrame(frame);
}

function update(dt) {
  const core = {
    x: CX, y: CY,
    goalR: goalRadius(),
    requireOrder: game.requireOrder,
    captureScale: game.captureScale,
  };

  // 波
  for (let i = game.waves.length - 1; i >= 0; i--) {
    const w = game.waves[i];
    const alive = w.update(dt);
    if (!alive) { game.waves.splice(i, 1); continue; }
    for (const s of game.shards) {
      const verdict = w.apply(s, CX, CY, game);
      if (verdict === "unlocked") {
        const idx = game.shards.indexOf(s);
        game.particles.push(...burstParticles(s.x, s.y, 14, 0.7));
        Audio_.enter(2, game.theme);
        void idx;
      } else if (verdict === "wrong-unlock") {
        game.failReason = "解锁顺序错误";
      } else if (verdict === "obstacle") {
        game.failReason = "目标停在危险区里，波纹无法收拢";
      }
    }
  }

  // 碎片
  for (const s of game.shards) s.update(dt, game.time, core);

  // 顺序目标推进
  if (game.orderActive) {
    const before = game.requireOrder;
    syncOrderState(false);
    if (before !== game.requireOrder && game.requireOrder !== null) {
      Audio_.enter(3, game.theme);
    }
  }

  // 碎片之间的碰撞
  for (let i = 0; i < game.shards.length; i++) {
    for (let j = i + 1; j < game.shards.length; j++) {
      collide(game.shards[i], game.shards[j]);
    }
  }

  // 粒子
  for (let i = game.particles.length - 1; i >= 0; i--) {
    const p = game.particles[i];
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.vx *= Math.exp(-3.4 * dt);
    p.vy *= Math.exp(-3.4 * dt);
    p.life -= dt * 1.5;
    if (p.life <= 0) game.particles.splice(i, 1);
  }

  // 计数与通关：必须先真正开始游戏（有碎片、且已进入关卡）才判定，
  // 否则开场遮罩期间的空状态会被误判成通关。
  updateCounter();
  const all = game.started && game.shards.length > 0 &&
    game.shards.every(s => s.settled);
  if (all && !game.solved) {
    // 全部入圈后，额外加强阻尼让它们安静停下，再判定通关
    for (const s of game.shards) {
      s.vx *= Math.exp(-6 * dt);
      s.vy *= Math.exp(-6 * dt);
    }
    // 需要同时停留 0.4 秒，避免一瞬间穿过判定区
    const minTime = Math.min(...game.shards.map(s => s.insideTime));
    if (minTime > 0.4) {
      game.solved = true;
      game.failed = false;          // 通关优先于失败，避免同一帧被判负
      game.failReason = "";
      game.failCheckAt = -1;
      game.completeDelay = 1.0;
      Audio_.complete(game.theme);
      // 通关粒子
      game.particles.push(...burstParticles(CX, CY, 60, 1.6));
    }
  }

  if (game.solved) {
    game.failed = false;
    game.failReason = "";
    game.solvedTimer += dt;
    if (game.completeDelay > 0) {
      game.completeDelay -= dt;
      if (game.completeDelay <= 0) nextLevelPrompt();
    }
  }

  // 失败判定：波纹用完，等所有碎片都停下来再结算。
  // 这样玩家松手后还能看完整个滑行过程，不会在运动中被判负。
  if (!game.solved && !game.failed && game.started && game.waveBudget === 0) {
    // 鼠标还按着就不结算，避免"手没松就被判失败"
    if (game.dragging || game.pointerDown) {
      // 保持"等待中"，但不能永远停在这里：松手后仍要能结算
      if (game.failCheckAt > 0) game.failCheckAt = -1;
    } else {
      // 波还在扩散、碎片还在滑动时，都不结算
      const wavesGone = game.waves.length === 0;
      const allStill = game.shards.every(s =>
        s.locked || s.settled || Math.hypot(s.vx, s.vy) < 6 * SCALE);
      if (game.failCheckAt < 0) {
        // 等待运动停止；一旦真的停了就进入倒计时
        if (wavesGone && allStill) game.failCheckAt = 0.5;
      } else if (game.failCheckAt > 0) {
        game.failCheckAt -= dt;
        if (game.failCheckAt <= 0) failLevel();
      }
    }
  }
}

// 生成一圈粒子。视觉用确定性随机，不影响判定。
function burstParticles(x, y, n, speedScale) {
  const out = [];
  const rnd = game.particleRnd;
  for (let i = 0; i < n; i++) {
    const a = rnd() * TAU;
    const sp = lerp(80, 300, rnd()) * SCALE * (speedScale || 1);
    out.push({
      x, y,
      vx: Math.cos(a) * sp,
      vy: Math.sin(a) * sp,
      life: 1,
      r: lerp(0.9, 2.4, rnd()) * SCALE,
    });
  }
  return out;
}

// 判定失败原因：让玩家知道"哪一个决策错了"。
function diagnoseFailure() {
  if (game.failReason) return game.failReason;
  const pending = game.shards.filter(s => !s.settled);
  const lockedLeft = pending.filter(s => s.locked).length;
  if (lockedLeft) return "还有目标没有被解锁";
  const ordered = pending.filter(s => s.order > 0 && s.order !== game.requireOrder).length;
  if (ordered) return "顺序错误：应先处理编号更小的目标";
  const overshoot = pending.filter(s => {
    const d = Math.hypot(s.x - CX, s.y - CY);
    return s.insideTime === 0 && d > goalRadius() * 2.2;
  }).length;
  if (overshoot) return "力度过大，目标冲出了光核";
  const repelled = game.shards.filter(s => s.repelled > 0).length;
  if (repelled) return "目标停在危险区或力度不足";
  return "力度不足，目标没能进入光核";
}

/* ------------------ 失败流程 ------------------ */
function failLevel() {
  if (game.failed || game.solved) return;
  game.failed = true;
  // 不再把 started 置 false：失败时遮挡输入的是失败浮层，
  // 而 started 表示"本关会话进行中"。两者混用会让重试后鼠标失效。
  game.dragging = false;
  Audio_.endDrag();
  game.strength = 0;
  Audio_.fail();

  progress.failsInARow++;
  let lostLife = false;
  if (progress.failsInARow >= FAILS_PER_LIFE) {
    progress.failsInARow = 0;
    progress.lives--;
    lostLife = true;
  }
  saveProgress();
  updateLives();

  if (progress.lives <= 0) {
    progress.lives = 0;
    saveProgress();
    showOverlay(
      "No Lives",
      "能量耗尽",
      `连续 ${FAILS_PER_LIFE} 次未能让世界归于平静，生命耗尽了。<br><br>回到选关界面，进度仍然保留。`,
      [{ text: "回到选关", primary: true, onClick: () => { progress.lives = 3; progress.failsInARow = 0; saveProgress(); openSelect(); } }]
    );
    return;
  }

  const remain = FAILS_PER_LIFE - progress.failsInARow;
  const reason = diagnoseFailure();
  showOverlay(
    "Waves Spent",
    "波纹用尽",
    `<span style="color:var(--accent)">${reason}</span><br>` +
    (lostLife
      ? `没能把所有${themeWord(LEVELS[game.index], "shard")}收拢。失去一条生命，还剩 ${progress.lives} 条。`
      : `没能把所有${themeWord(LEVELS[game.index], "shard")}收拢。再连续失败 ${remain} 次会失去一条生命。`),
    [
      { text: "重试本关", primary: true, onClick: () => loadLevel(game.index, false) },
      { text: "选关", onClick: openSelect },
    ]
  );
}

function collide(a, b) {
  const dx = b.x - a.x, dy = b.y - a.y;
  const d = Math.hypot(dx, dy) || 0.001;
  const minD = a.r + b.r;
  if (d >= minD) return;

  const nx = dx / d, ny = dy / d;
  const overlap = minD - d;

  const mA = a.locked ? Infinity : a.mass;
  const mB = b.locked ? Infinity : b.mass;

  // 位置分离
  if (mA === Infinity && mB === Infinity) return;
  if (mA === Infinity) {
    b.x += nx * overlap; b.y += ny * overlap;
  } else if (mB === Infinity) {
    a.x -= nx * overlap; a.y -= ny * overlap;
  } else {
    const total = mA + mB;
    a.x -= nx * overlap * (mB / total);
    a.y -= ny * overlap * (mB / total);
    b.x += nx * overlap * (mA / total);
    b.y += ny * overlap * (mA / total);
  }

  // 冲量
  const rvx = b.vx - a.vx, rvy = b.vy - a.vy;
  const sep = rvx * nx + rvy * ny;
  if (sep > 0) return;

  const e = Math.min(a.bounce || 0.28, b.bounce || 0.28);
  if (mA === Infinity) {
    const j = -(1 + e) * sep;
    b.vx += nx * j; b.vy += ny * j;
    b.pulse = Math.min(1, b.pulse + 0.5);
  } else if (mB === Infinity) {
    const j = -(1 + e) * sep;
    a.vx -= nx * j; a.vy -= ny * j;
    a.pulse = Math.min(1, a.pulse + 0.5);
  } else {
    const j = -(1 + e) * sep / (1 / mA + 1 / mB);
    a.vx -= nx * j / mA; a.vy -= ny * j / mA;
    b.vx += nx * j / mB; b.vy += ny * j / mB;
    a.pulse = Math.min(1, a.pulse + 0.4);
    b.pulse = Math.min(1, b.pulse + 0.4);
  }
}

function nextLevelPrompt() {
  const idx = game.index;
  const cfg = LEVELS[idx];
  const theme = THEMES[cfg.theme] || THEMES.space;

  // 记录通关、解锁下一关、重置连续失败计数
  if (!progress.cleared.includes(idx)) progress.cleared.push(idx);
  progress.failsInARow = 0;
  const unlockedNew = progress.unlocked === idx + 1 && idx + 1 < LEVELS.length;
  if (unlockedNew) progress.unlocked = idx + 2;
  saveProgress();

  const isLast = idx >= LEVELS.length - 1;
  const used = game.waveBudgetMax - game.waveBudget;
  const perfect = used === 1;

  // 本章主题的收尾文案
  const epilogue = {
    space: "小行星都已回到行星的引力环中。",
    water: "游鱼安静下来，水面重新变得平滑。",
    deep: "声呐的回响散去，深渊归于沉寂。",
    aurora: "冰晶停驻，极光缓缓流过光核。",
  }[cfg.theme] || "一切归于平静。";

  if (isLast) {
    showOverlay(
      "All Worlds Cleared",
      "全部完成",
      `${epilogue}<br><br>每个世界都已归于平静。<br>你可以回到选关界面重玩任意一关。`,
      [{ text: "回到选关", primary: true, onClick: openSelect }]
    );
    game.started = false;
    return;
  }

  const nextCfg = LEVELS[idx + 1];
  const nextTheme = THEMES[nextCfg.theme] || THEMES.space;
  const extra = perfect ? "<br><br><span style='color:var(--accent)'>一次波纹就完成。</span>" : "";
  const unlockLine = unlockedNew
    ? `<br><br>新世界已解锁：<span style='color:var(--accent)'>${nextTheme.label} · ${nextCfg.name}</span>`
    : `<br><br>下一关：<span style='color:var(--accent)'>${nextCfg.name}</span>`;

  showOverlay(
    "Level " + String(idx + 1).padStart(2, "0") + " Clear",
    epilogue,
    `用了 ${used} / ${game.waveBudgetMax} 道${themeWord(cfg, "wave")}。${unlockLine}${extra}`,
    [
      { text: "下一关", primary: true, onClick: () => loadLevel(idx + 1, false) },
      { text: "选关", onClick: openSelect },
    ]
  );
}

/* ------------------ 渲染 ------------------ */
function render() {
  const t = game.time;
  const goalR = goalRadius();
  const th = game.theme;

  ctx.fillStyle = th.bg;
  ctx.fillRect(0, 0, W, H);

  drawBackdrop(t, th);

  // 危险区先画，位于光圈之下，保持低对比度
  drawObstacles(th);

  // 移动目标的固定轨迹
  drawTrajectories(t, th);

  // 光圈
  drawGoalCore(t, goalR, th);

  // 波
  for (const w of game.waves) w.draw(1, th);

  // 碎片
  for (const s of game.shards) s.draw(t, th);

  // 顺序编号 / 停驻进度画在最上层
  for (const s of game.shards) {
    drawShardMarks(s, th);
    drawOrderBadge(s, th);
    drawSettleRing(s, th);
  }

  // 粒子
  for (const p of game.particles) {
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r * p.life, 0, TAU);
    ctx.fillStyle = rgba(th.accentRGB, 0.55 * p.life);
    ctx.fill();
  }

  // 拖拽指示
  if (game.dragging) drawDragAim(th);

  // 通关时的整体呼吸
  if (game.solved) {
    const a = Math.sin(game.solvedTimer * 3.2) * 0.5 + 0.5;
    ctx.beginPath();
    ctx.arc(CX, CY, goalR * (2.2 + a * 0.5), 0, TAU);
    ctx.strokeStyle = rgba(th.accentRGB, 0.05 + a * 0.07);
    ctx.lineWidth = 1;
    ctx.stroke();
  }
}

// 危险扇区：暖灰低对比度的可读几何区域（不使用高饱和警告色）
function drawObstacles(th) {
  if (!game.obstacles || !game.obstacles.length) return;
  for (const o of game.obstacles) {
    const a0 = o.angle - o.width / 2;
    const a1 = o.angle + o.width / 2;
    ctx.beginPath();
    ctx.arc(CX, CY, o.outer, a0, a1);
    ctx.arc(CX, CY, o.inner, a1, a0, true);
    ctx.closePath();
    ctx.fillStyle = "rgba(176, 148, 128, 0.10)";
    ctx.fill();
    ctx.strokeStyle = "rgba(206, 176, 152, 0.42)";
    ctx.lineWidth = 1;
    ctx.setLineDash([5, 6]);
    ctx.stroke();
    ctx.setLineDash([]);

    // 外缘再补一条实线弧，让边界在浅色主题下也读得出来
    ctx.beginPath();
    ctx.arc(CX, CY, o.outer, a0, a1);
    ctx.strokeStyle = "rgba(206, 176, 152, 0.30)";
    ctx.lineWidth = 1.4;
    ctx.stroke();
  }
}

// 移动目标的固定轨迹：极低透明度细线 + 两端的静默端点，
// 让玩家在释放前就能看清目标会走到哪里。
function drawTrajectories(t, th) {
  for (const s of game.shards) {
    if (s.driftMode === "none" || s.driftAmplitude <= 0) continue;
    const [ax, ay] = s.rotateOffset(1);
    const p0 = [s.home[0] - ax, s.home[1] - ay];
    const p1 = [s.home[0] + ax, s.home[1] + ay];
    ctx.beginPath();
    ctx.moveTo(p0[0], p0[1]);
    ctx.lineTo(p1[0], p1[1]);
    ctx.strokeStyle = rgba(th.inkRGB, s.settled ? 0.04 : 0.13);
    ctx.lineWidth = 1;
    ctx.setLineDash([2, 7]);
    ctx.stroke();
    ctx.setLineDash([]);
    for (const p of [p0, p1]) {
      ctx.beginPath();
      ctx.arc(p[0], p[1], 2.2 * SCALE, 0, TAU);
      ctx.fillStyle = rgba(th.inkRGB, 0.18);
      ctx.fill();
    }
  }
}

// 目标标记：只保留"解锁虚环"与"当前目标环"，不再重复画停驻环。
function drawShardMarks(s, th) {
  const r = s.r;

  // 危险扇区里的目标：在扇区外缘补一条"这里推不动"的提示弧，
  // 而不是贴着碎片画环，避免与碎片自身的圆环混在一起。
  if (game.obstacles && game.obstacles.length && !s.settled) {
    const dx = s.x - CX, dy = s.y - CY;
    const dist = Math.hypot(dx, dy);
    const ang = Math.atan2(dy, dx);
    for (const o of game.obstacles) {
      let diff = Math.abs(((ang - o.angle + Math.PI * 3) % (Math.PI * 2)) - Math.PI);
      if (diff > o.width / 2) continue;
      const rr = Math.max(o.outer, dist + 26 * SCALE);
      ctx.beginPath();
      ctx.arc(CX, CY, rr, ang - 0.16, ang + 0.16);
      ctx.strokeStyle = "rgba(206, 176, 152, 0.55)";
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(CX, CY, rr + 5 * SCALE, ang - 0.10, ang + 0.10);
      ctx.strokeStyle = "rgba(206, 176, 152, 0.28)";
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }

  if (s.locked) {
    ctx.beginPath();
    ctx.arc(s.x, s.y, r + 11 * SCALE, 0, TAU);
    ctx.strokeStyle = "rgba(232, 184, 127, 0.34)";
    ctx.lineWidth = 1;
    ctx.setLineDash([1.5, 3.5]);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // 当前必须处理的目标用更明显的细环提示
  const isCurrent = s.order > 0 && !s.settled &&
    (!game.orderActive || s.order === game.requireOrder);
  if (isCurrent) {
    ctx.beginPath();
    ctx.arc(s.x, s.y, r + 7 * SCALE, 0, TAU);
    ctx.strokeStyle = rgba(th.accentRGB, 0.45);
    ctx.lineWidth = 1;
    ctx.stroke();
  }
}

// 停驻进度环：只对需要"停留一段时间"的目标显示
function drawSettleRing(s, th) {
  if (!s.settleDuration || s.settled) return;
  const r = s.r;
  if (!s.inside) {
    // 未进圈时画一圈极淡的底环，提示"这个目标需要停稳"
    ctx.beginPath();
    ctx.arc(s.x, s.y, r + 12 * SCALE, 0, TAU);
    ctx.strokeStyle = rgba(th.inkRGB, 0.14);
    ctx.lineWidth = 2;
    ctx.stroke();
    return;
  }
  const p = clamp(s.holdTime / s.settleDuration, 0, 1);
  ctx.beginPath();
  ctx.arc(s.x, s.y, r + 12 * SCALE, -Math.PI / 2, -Math.PI / 2 + TAU * p);
  ctx.strokeStyle = rgba(th.accentRGB, 0.8);
  ctx.lineWidth = 2;
  ctx.stroke();
}

// 顺序编号：只画一个极简数字，不堆叠文字
function drawOrderBadge(s, th) {
  if (!s.order || s.settled) return;
  const r = s.r;
  const x = s.x + r * 0.92;
  const y = s.y - r * 0.92;
  const active = !game.orderActive || s.order === game.requireOrder;
  ctx.beginPath();
  ctx.arc(x, y, 7 * SCALE, 0, TAU);
  ctx.fillStyle = active ? rgba(th.accentRGB, 0.22) : "rgba(11, 13, 16, 0.55)";
  ctx.fill();
  ctx.strokeStyle = active ? rgba(th.accentRGB, 0.85) : rgba(th.inkRGB, 0.25);
  ctx.lineWidth = 1;
  ctx.stroke();
  ctx.fillStyle = active ? rgba(th.accentRGB, 0.98) : rgba(th.inkRGB, 0.45);
  ctx.font = `${Math.max(8, 8.5 * SCALE)}px "Inter", -apple-system, sans-serif`;
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText(String(s.order), x, y + 0.5);
}

// 把十六进制主题色转成 rgb 分量，便于按透明度使用
function toRGB(hex) {
  const h = hex.replace("#", "");
  const n = parseInt(h.length === 3 ? h.split("").map(c => c + c).join("") : h, 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}
function rgba(rgb, a) {
  if (!rgb) return `rgba(232,236,241,${a})`;
  return `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, ${a})`;
}

// 预计算每个主题的 rgb 分量，避免每帧解析字符串
for (const key of Object.keys(THEMES)) {
  const th = THEMES[key];
  th.accentRGB = toRGB(th.accent);
  th.inkRGB = toRGB(th.ink);
}

/* ------------------ 主题化背景 ------------------ */
// 星野种子：每个主题一份固定的随机星点，避免每帧闪烁
const starField = (() => {
  const seeds = [];
  let s = 20240911;
  const rnd = () => (s = (s * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff;
  for (let i = 0; i < 190; i++) {
    seeds.push({
      x: rnd(), y: rnd(), r: 0.4 + rnd() * 1.5,
      ph: rnd() * TAU, sp: 0.3 + rnd() * 1.4,
    });
  }
  return seeds;
})();

function drawBackdrop(t, th) {
  ctx.save();

  if (th.backdrop === "stars") {
    // 太空：缓慢闪烁的星点 + 极淡的星系旋臂
    for (const s of starField) {
      const a = 0.10 + 0.30 * (0.5 + 0.5 * Math.sin(t * s.sp + s.ph));
      ctx.beginPath();
      ctx.arc(s.x * W, s.y * H, s.r * SCALE, 0, TAU);
      ctx.fillStyle = rgba(th.accentRGB, a * 0.8);
      ctx.fill();
    }
    for (let i = 1; i <= 4; i++) {
      const r = i * 130 * SCALE + Math.sin(t * 0.3 + i) * 6 * SCALE;
      ctx.beginPath();
      ctx.arc(CX, CY, r, 0, TAU);
      ctx.strokeStyle = rgba(th.accentRGB, 0.028 - i * 0.004);
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  } else if (th.backdrop === "caustics") {
    // 水面：横向的柔和水波光带
    for (let i = 0; i < 7; i++) {
      const y = H * (0.14 + i * 0.12) + Math.sin(t * 0.45 + i * 1.3) * 9 * SCALE;
      const amp = (10 + i * 2) * SCALE;
      ctx.beginPath();
      for (let x = 0; x <= W; x += 14) {
        const yy = y + Math.sin(x * 0.008 + t * 0.8 + i) * amp;
        if (x === 0) ctx.moveTo(x, yy); else ctx.lineTo(x, yy);
      }
      ctx.strokeStyle = rgba(th.accentRGB, 0.05 - i * 0.004);
      ctx.lineWidth = 1;
      ctx.stroke();
    }
    for (let i = 1; i <= 5; i++) {
      const r = i * 120 * SCALE + Math.sin(t * 0.6 + i * 0.9) * 8 * SCALE;
      ctx.beginPath();
      ctx.arc(CX, CY, r, 0, TAU);
      ctx.strokeStyle = rgba(th.accentRGB, 0.03 - i * 0.004);
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  } else if (th.backdrop === "depth") {
    // 深海：柔和的斜向光晕（不用硬边色带，避免割裂画面）+ 悬浮微粒
    for (let i = 0; i < 3; i++) {
      const x = W * (0.22 + i * 0.28) + Math.sin(t * 0.22 + i * 1.7) * 26 * SCALE;
      const g = ctx.createRadialGradient(x, -H * 0.1, 0, x, -H * 0.1, H * 0.95);
      g.addColorStop(0, rgba(th.accentRGB, 0.055 - i * 0.01));
      g.addColorStop(0.55, rgba(th.accentRGB, 0.022 - i * 0.005));
      g.addColorStop(1, rgba(th.accentRGB, 0));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.ellipse(x, H * 0.28, W * 0.17, H * 0.62, 0, 0, TAU);
      ctx.fill();
    }
    // 深处更暗的渐隐，营造下沉感
    const dark = ctx.createLinearGradient(0, 0, 0, H);
    dark.addColorStop(0, "rgba(0,0,0,0)");
    dark.addColorStop(1, "rgba(0,0,0,0.45)");
    ctx.fillStyle = dark;
    ctx.fillRect(0, 0, W, H);

    for (const s of starField.slice(0, 80)) {
      const y = (s.y + t * 0.012 * s.sp) % 1;
      ctx.beginPath();
      ctx.arc(s.x * W, y * H, s.r * SCALE * 0.8, 0, TAU);
      ctx.fillStyle = rgba(th.accentRGB, 0.10 + 0.16 * Math.sin(t * s.sp + s.ph));
      ctx.fill();
    }
  } else if (th.backdrop === "dunes") {
    // 荒漠：层层起伏的沙丘轮廓 + 缓慢飘移的沙尘
    for (let i = 0; i < 4; i++) {
      const baseY = H * (0.46 + i * 0.14);
      ctx.beginPath();
      ctx.moveTo(-20, H);
      for (let x = -20; x <= W + 20; x += 16) {
        const y = baseY + Math.sin(x * 0.004 + i * 1.3 + t * 0.12) * 26 * SCALE
          + Math.sin(x * 0.011 + i) * 8 * SCALE;
        ctx.lineTo(x, y);
      }
      ctx.lineTo(W + 20, H);
      ctx.closePath();
      ctx.fillStyle = rgba(th.accentRGB, 0.018 + i * 0.01);
      ctx.fill();
      ctx.strokeStyle = rgba(th.accentRGB, 0.06 - i * 0.011);
      ctx.lineWidth = 1;
      ctx.stroke();
    }
    for (const s of starField.slice(0, 60)) {
      const x = ((s.x + t * 0.02 * s.sp) % 1 + 1) % 1;
      ctx.beginPath();
      ctx.arc(x * W, s.y * H, s.r * SCALE * 0.7, 0, TAU);
      ctx.fillStyle = rgba(th.accentRGB, 0.05 + 0.08 * Math.sin(t * s.sp + s.ph));
      ctx.fill();
    }
  } else if (th.backdrop === "canopy") {
    // 林间：斜射的光柱 + 顶部树冠剪影 + 飘浮孢子
    for (let i = 0; i < 4; i++) {
      const x = W * (0.18 + i * 0.22) + Math.sin(t * 0.16 + i * 1.4) * 16 * SCALE;
      const topW = 34 * SCALE;
      const botW = 96 * SCALE;
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, rgba(th.accentRGB, 0.075 - i * 0.011));
      g.addColorStop(0.6, rgba(th.accentRGB, 0.03 - i * 0.005));
      g.addColorStop(1, rgba(th.accentRGB, 0));
      ctx.fillStyle = g;
      ctx.beginPath();
      // 下宽上窄的斜光柱，比椭圆光斑更像穿过树冠的光
      ctx.moveTo(x - topW / 2, -10);
      ctx.lineTo(x + topW / 2, -10);
      ctx.lineTo(x + botW / 2 + 40 * SCALE, H);
      ctx.lineTo(x - botW / 2 + 40 * SCALE, H);
      ctx.closePath();
      ctx.fill();
    }
    ctx.beginPath();
    ctx.moveTo(0, 0);
    for (let x = 0; x <= W; x += 22) {
      ctx.lineTo(x, 26 * SCALE + Math.sin(x * 0.006 + t * 0.1) * 20 * SCALE);
    }
    ctx.lineTo(W, 0);
    ctx.closePath();
    ctx.fillStyle = "rgba(0,0,0,0.42)";
    ctx.fill();

    for (const s of starField.slice(0, 80)) {
      const y = (s.y + t * 0.01 * s.sp) % 1;
      const x = s.x * W + Math.sin(t * 0.5 + s.ph) * 12 * SCALE;
      ctx.beginPath();
      ctx.arc(x, y * H, s.r * SCALE * 0.9, 0, TAU);
      ctx.fillStyle = rgba(th.accentRGB, 0.10 + 0.24 * (0.5 + 0.5 * Math.sin(t * s.sp * 2 + s.ph)));
      ctx.fill();
    }
  } else if (th.backdrop === "frost") {
    // 冰原：顶部极地辉光 + 细密霜纹 + 细小冰晶
    const glow = ctx.createRadialGradient(CX, H * 0.06, 0, CX, H * 0.06, H * 0.92);
    glow.addColorStop(0, rgba(th.accentRGB, 0.08));
    glow.addColorStop(1, rgba(th.accentRGB, 0));
    ctx.fillStyle = glow;
    ctx.fillRect(0, 0, W, H);

    for (let i = 0; i < 30; i++) {
      const s = starField[i];
      const x = s.x * W, y = s.y * H;
      const len = (7 + s.r * 9) * SCALE;
      const a = s.ph + t * 0.05;
      ctx.beginPath();
      for (let k = 0; k < 3; k++) {
        const ang = a + k * Math.PI / 3;
        ctx.moveTo(x - Math.cos(ang) * len, y - Math.sin(ang) * len);
        ctx.lineTo(x + Math.cos(ang) * len, y + Math.sin(ang) * len);
      }
      ctx.strokeStyle = rgba(th.accentRGB, 0.05 + 0.05 * Math.sin(t * 0.6 + s.ph));
      ctx.lineWidth = 0.7;
      ctx.stroke();
    }
    for (const s of starField.slice(30, 86)) {
      ctx.beginPath();
      ctx.arc(s.x * W, s.y * H, s.r * SCALE * 0.8, 0, TAU);
      ctx.fillStyle = rgba(th.inkRGB, 0.16 + 0.2 * Math.sin(t * s.sp + s.ph));
      ctx.fill();
    }
  } else if (th.backdrop === "ash") {
    // 熔岩：底部余烬辉光 + 自下而上飘升的火星
    const glow = ctx.createRadialGradient(CX, H * 1.08, 0, CX, H * 1.08, H * 1.02);
    glow.addColorStop(0, rgba(th.accentRGB, 0.17));
    glow.addColorStop(0.5, rgba(th.accentRGB, 0.05));
    glow.addColorStop(1, rgba(th.accentRGB, 0));
    ctx.fillStyle = glow;
    ctx.fillRect(0, 0, W, H);

    for (const s of starField.slice(0, 90)) {
      const y = ((s.y - t * 0.03 * s.sp) % 1 + 1) % 1;
      const x = s.x * W + Math.sin(t * 0.8 + s.ph) * 14 * SCALE;
      const a = 0.10 + 0.34 * (0.5 + 0.5 * Math.sin(t * s.sp * 3 + s.ph));
      ctx.beginPath();
      ctx.arc(x, y * H, s.r * SCALE * 0.75, 0, TAU);
      ctx.fillStyle = rgba(th.accentRGB, a);
      ctx.fill();
    }
  } else {
    // 极光：缓慢流动的弧形光带
    for (let band = 0; band < 3; band++) {
      const baseY = H * (0.18 + band * 0.14);
      const grd = ctx.createLinearGradient(0, baseY, W, baseY + 120 * SCALE);
      grd.addColorStop(0, rgba(th.accentRGB, 0.0));
      grd.addColorStop(0.5, rgba(th.accentRGB, 0.055 - band * 0.012));
      grd.addColorStop(1, rgba(th.accentRGB, 0.0));
      ctx.strokeStyle = grd;
      ctx.lineWidth = (26 + band * 10) * SCALE;
      ctx.beginPath();
      for (let x = -40; x <= W + 40; x += 18) {
        const yy = baseY + Math.sin(x * 0.0035 + t * 0.4 + band * 1.7) * 46 * SCALE
          + Math.sin(x * 0.011 + t * 0.7) * 12 * SCALE;
        if (x <= -40) ctx.moveTo(x, yy); else ctx.lineTo(x, yy);
      }
      ctx.stroke();
    }
  }

  ctx.restore();
}

function drawGoalCore(t, goalR, th) {
  const n = game.shards.filter(s => s.inside).length;
  const total = game.shards.length;
  const full = total > 0 && n === total;

  // 光圈填充
  const g = ctx.createRadialGradient(CX, CY, 0, CX, CY, goalR);
  g.addColorStop(0, rgba(th.accentRGB, full ? 0.15 : 0.06));
  g.addColorStop(1, rgba(th.accentRGB, 0));
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.arc(CX, CY, goalR, 0, TAU);
  ctx.fill();

  // 光圈边界
  ctx.beginPath();
  ctx.arc(CX, CY, goalR, 0, TAU);
  ctx.strokeStyle = rgba(th.accentRGB, full ? 0.85 : 0.34);
  ctx.lineWidth = 1;
  ctx.stroke();

  // 进度弧：光圈里已就位的碎片比例
  if (total > 0) {
    const start = -Math.PI / 2;
    ctx.beginPath();
    ctx.arc(CX, CY, goalR + 7 * SCALE, start, start + TAU * (n / total));
    ctx.strokeStyle = rgba(th.accentRGB, 0.62);
    ctx.lineWidth = 1.6;
    ctx.lineCap = "round";
    ctx.stroke();
  }

  drawCoreShape(t, goalR, th);

  // 通关时的整体呼吸环
  if (game.solved) {
    const a = 0.5 + 0.5 * Math.sin(game.solvedTimer * 3.2);
    ctx.beginPath();
    ctx.arc(CX, CY, goalR * (1.35 + a * 0.3), 0, TAU);
    ctx.strokeStyle = rgba(th.accentRGB, 0.10 + a * 0.12);
    ctx.lineWidth = 1.2;
    ctx.stroke();
  }
}

// 每个主题的核心形态不同：行星 / 荷叶 / 水母 / 光核
function drawCoreShape(t, goalR, th) {
  const pulse = 1 + Math.sin(t * 1.9) * 0.12;
  const style = th.coreStyle;

  if (style === "planet") {
    // 行星：实心球 + 倾斜的引力环
    const r = 9 * SCALE * pulse;
    const cg = ctx.createRadialGradient(CX - r * 0.3, CY - r * 0.3, 0, CX, CY, r);
    cg.addColorStop(0, rgba(th.accentRGB, 0.95));
    cg.addColorStop(0.55, rgba(th.accentRGB, 0.42));
    cg.addColorStop(1, rgba(th.accentRGB, 0.12));
    ctx.fillStyle = cg;
    ctx.beginPath();
    ctx.arc(CX, CY, r, 0, TAU);
    ctx.fill();

    ctx.save();
    ctx.translate(CX, CY);
    ctx.rotate(-0.42);
    ctx.beginPath();
    ctx.ellipse(0, 0, r * 3.1, r * 0.95, 0, 0, TAU);
    ctx.strokeStyle = rgba(th.accentRGB, 0.4);
    ctx.lineWidth = 1.1;
    ctx.stroke();
    ctx.restore();

    const halo = ctx.createRadialGradient(CX, CY, 0, CX, CY, r * 6);
    halo.addColorStop(0, rgba(th.accentRGB, 0.16));
    halo.addColorStop(1, rgba(th.accentRGB, 0));
    ctx.fillStyle = halo;
    ctx.beginPath();
    ctx.arc(CX, CY, r * 6, 0, TAU);
    ctx.fill();

  } else if (style === "pad") {
    // 荷叶：带缺口的椭圆叶面，尺寸放大以便在光圈里清晰可辨
    const r = 26 * SCALE * pulse;
    ctx.save();
    ctx.translate(CX, CY);

    // 叶面
    ctx.beginPath();
    ctx.ellipse(0, 0, r * 1.22, r, 0, 0.34, TAU + 0.1);
    ctx.closePath();
    ctx.fillStyle = rgba(th.accentRGB, 0.26);
    ctx.fill();
    ctx.strokeStyle = rgba(th.accentRGB, 0.8);
    ctx.lineWidth = 1.2;
    ctx.stroke();

    // 叶脉：从中心放射
    for (let i = 0; i < 7; i++) {
      const a = -Math.PI / 2 + i * (TAU / 7) + 0.42;
      ctx.beginPath();
      ctx.moveTo(Math.cos(a) * r * 0.12, Math.sin(a) * r * 0.1);
      ctx.lineTo(Math.cos(a) * r * 1.1, Math.sin(a) * r * 0.88);
      ctx.strokeStyle = rgba(th.accentRGB, 0.3);
      ctx.lineWidth = 0.7;
      ctx.stroke();
    }

    // 叶缘的浅色描边，强化轮廓
    ctx.beginPath();
    ctx.ellipse(0, 0, r * 1.22, r, 0, 0.34, TAU + 0.1);
    ctx.strokeStyle = rgba(th.accentRGB, 0.9);
    ctx.lineWidth = 0.9;
    ctx.stroke();

    // 中心水珠高光
    const drop = ctx.createRadialGradient(-r * 0.1, -r * 0.12, 0, 0, 0, r * 0.3);
    drop.addColorStop(0, rgba(th.accentRGB, 1));
    drop.addColorStop(0.6, rgba(th.accentRGB, 0.5));
    drop.addColorStop(1, rgba(th.accentRGB, 0));
    ctx.fillStyle = drop;
    ctx.beginPath();
    ctx.arc(0, 0, r * 0.3, 0, TAU);
    ctx.fill();
    ctx.restore();

  } else if (style === "jelly") {
    // 水母：伞盖 + 飘动的触须
    const r = 12 * SCALE * pulse;
    ctx.beginPath();
    ctx.arc(CX, CY, r, Math.PI, TAU);
    ctx.quadraticCurveTo(CX + r, CY, CX, CY);
    ctx.quadraticCurveTo(CX - r, CY, CX - r, CY);
    ctx.closePath();
    ctx.fillStyle = rgba(th.accentRGB, 0.2);
    ctx.fill();
    ctx.strokeStyle = rgba(th.accentRGB, 0.65);
    ctx.lineWidth = 1;
    ctx.stroke();

    for (let i = -2; i <= 2; i++) {
      const x0 = CX + i * r * 0.42;
      const sway = Math.sin(t * 1.5 + i) * 5 * SCALE;
      ctx.beginPath();
      ctx.moveTo(x0, CY);
      ctx.quadraticCurveTo(x0 + sway, CY + r * 1.5, x0 + sway * 0.6, CY + r * 2.6);
      ctx.strokeStyle = rgba(th.accentRGB, 0.3);
      ctx.lineWidth = 0.8;
      ctx.stroke();
    }

    const halo = ctx.createRadialGradient(CX, CY, 0, CX, CY, r * 5.5);
    halo.addColorStop(0, rgba(th.accentRGB, 0.15));
    halo.addColorStop(1, rgba(th.accentRGB, 0));
    ctx.fillStyle = halo;
    ctx.beginPath();
    ctx.arc(CX, CY, r * 5.5, 0, TAU);
    ctx.fill();

  } else if (style === "oasis") {
    // 水洼：一圈水边缘 + 不断扩散的细微涟漪
    const r = 22 * SCALE;
    const g = ctx.createRadialGradient(CX, CY, 0, CX, CY, r);
    g.addColorStop(0, rgba(th.accentRGB, 0.3));
    g.addColorStop(0.7, rgba(th.accentRGB, 0.12));
    g.addColorStop(1, rgba(th.accentRGB, 0.03));
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.ellipse(CX, CY, r * 1.15, r * 0.86, 0, 0, TAU);
    ctx.fill();
    ctx.strokeStyle = rgba(th.accentRGB, 0.75);
    ctx.lineWidth = 1.2;
    ctx.stroke();

    for (let i = 1; i <= 3; i++) {
      const k = ((t * 0.22 + i * 0.33) % 1);
      ctx.beginPath();
      ctx.ellipse(CX, CY, r * (0.3 + k * 0.9) * 1.15, r * (0.3 + k * 0.9) * 0.86, 0, 0, TAU);
      ctx.strokeStyle = rgba(th.accentRGB, 0.28 * (1 - k));
      ctx.lineWidth = 0.8;
      ctx.stroke();
    }

  } else if (style === "stump") {
    // 树桩：年轮截面
    const r = 20 * SCALE * pulse;
    ctx.beginPath();
    ctx.arc(CX, CY, r, 0, TAU);
    ctx.fillStyle = rgba(th.accentRGB, 0.14);
    ctx.fill();
    ctx.strokeStyle = rgba(th.accentRGB, 0.72);
    ctx.lineWidth = 1.2;
    ctx.stroke();

    for (let i = 1; i <= 4; i++) {
      ctx.beginPath();
      // 年轮略不规则，避免看起来像靶心
      ctx.arc(CX + Math.sin(i * 1.7) * r * 0.06,
              CY + Math.cos(i * 2.1) * r * 0.06,
              r * (i / 5), 0, TAU);
      ctx.strokeStyle = rgba(th.accentRGB, 0.30 - i * 0.045);
      ctx.lineWidth = 0.8;
      ctx.stroke();
    }
    ctx.beginPath();
    ctx.arc(CX, CY, r * 0.12, 0, TAU);
    ctx.fillStyle = rgba(th.accentRGB, 0.85);
    ctx.fill();

  } else if (style === "icecore") {
    // 冰眼：多层旋转的六边形，中心冷凝
    const r = 18 * SCALE * pulse;
    ctx.save();
    ctx.translate(CX, CY);
    for (let layer = 0; layer < 2; layer++) {
      const rr = r * (1 + layer * 0.5);
      ctx.save();
      ctx.rotate(t * (layer ? -0.22 : 0.3));
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const a = (i / 6) * TAU - Math.PI / 2;
        const px = Math.cos(a) * rr, py = Math.sin(a) * rr;
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.strokeStyle = rgba(th.accentRGB, layer ? 0.28 : 0.7);
      ctx.lineWidth = layer ? 0.7 : 1.1;
      ctx.stroke();
      if (!layer) {
        ctx.fillStyle = rgba(th.accentRGB, 0.16);
        ctx.fill();
      }
      ctx.restore();
    }
    ctx.restore();

    const halo = ctx.createRadialGradient(CX, CY, 0, CX, CY, r * 3.2);
    halo.addColorStop(0, rgba(th.accentRGB, 0.26));
    halo.addColorStop(1, rgba(th.accentRGB, 0));
    ctx.fillStyle = halo;
    ctx.beginPath();
    ctx.arc(CX, CY, r * 3.2, 0, TAU);
    ctx.fill();

  } else if (style === "embercore") {
    // 火心：跳动的核心 + 向外放射的短芒
    const r = 11 * SCALE;
    const flick = 0.86 + 0.14 * Math.sin(t * 5.3) + 0.06 * Math.sin(t * 11.7);
    const g = ctx.createRadialGradient(CX, CY, 0, CX, CY, r * 4.2 * flick);
    g.addColorStop(0, rgba(th.accentRGB, 0.55));
    g.addColorStop(0.35, rgba(th.accentRGB, 0.18));
    g.addColorStop(1, rgba(th.accentRGB, 0));
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(CX, CY, r * 4.2 * flick, 0, TAU);
    ctx.fill();

    ctx.beginPath();
    ctx.arc(CX, CY, r * 0.5 * flick, 0, TAU);
    ctx.fillStyle = rgba(th.accentRGB, 0.95);
    ctx.fill();

    const rays = 8;
    for (let i = 0; i < rays; i++) {
      const a = (i / rays) * TAU + t * 0.18;
      const len = r * (1.5 + 0.5 * Math.sin(t * 3.1 + i));
      ctx.beginPath();
      ctx.moveTo(CX + Math.cos(a) * r * 0.6, CY + Math.sin(a) * r * 0.6);
      ctx.lineTo(CX + Math.cos(a) * len, CY + Math.sin(a) * len);
      ctx.strokeStyle = rgba(th.accentRGB, 0.34);
      ctx.lineWidth = 0.9;
      ctx.stroke();
    }

  } else {
    // 光核：旋转的菱形晶体
    const r = 10 * SCALE * pulse;
    ctx.save();
    ctx.translate(CX, CY);
    ctx.rotate(t * 0.35);
    ctx.beginPath();
    ctx.moveTo(0, -r);
    ctx.lineTo(r * 0.7, 0);
    ctx.lineTo(0, r);
    ctx.lineTo(-r * 0.7, 0);
    ctx.closePath();
    ctx.fillStyle = rgba(th.accentRGB, 0.24);
    ctx.fill();
    ctx.strokeStyle = rgba(th.accentRGB, 0.75);
    ctx.lineWidth = 1.1;
    ctx.stroke();
    ctx.rotate(-t * 0.35 * 2);
    ctx.beginPath();
    ctx.arc(0, 0, r * 1.9, 0, TAU);
    ctx.strokeStyle = rgba(th.accentRGB, 0.2);
    ctx.lineWidth = 0.7;
    ctx.stroke();
    ctx.restore();

    const halo = ctx.createRadialGradient(CX, CY, 0, CX, CY, r * 6);
    halo.addColorStop(0, rgba(th.accentRGB, 0.18));
    halo.addColorStop(1, rgba(th.accentRGB, 0));
    ctx.fillStyle = halo;
    ctx.beginPath();
    ctx.arc(CX, CY, r * 6, 0, TAU);
    ctx.fill();
  }
}

function drawDragAim(th) {
  const s = game.strength;
  th = th || game.theme;

  // 预估强度半径：与 Wave.maxR 保持一致，只画到屏幕可见范围内
  const previewR = lerp(250, 560, s) * SCALE;
  const maxVisible = Math.min(W, H) * 0.46;
  const showRing = previewR < maxVisible;

  // 指引线：从按下点画到当前位置
  ctx.beginPath();
  ctx.moveTo(game.dragFrom[0], game.dragFrom[1]);
  ctx.lineTo(game.dragTo[0], game.dragTo[1]);
  ctx.strokeStyle = rgba(th.accentRGB, 0.28 + s * 0.5);
  ctx.lineWidth = 1.4;
  ctx.stroke();

  // 按下点标记，明确"我已经抓住你了"
  ctx.beginPath();
  ctx.arc(game.dragFrom[0], game.dragFrom[1], 5 * SCALE + s * 2, 0, TAU);
  ctx.strokeStyle = rgba(th.accentRGB, 0.4 + s * 0.4);
  ctx.lineWidth = 1;
  ctx.stroke();

  // 预估波锋：只在完整可见时才画，否则改用强度条表达
  if (showRing) {
    ctx.beginPath();
    ctx.arc(CX, CY, previewR, 0, TAU);
    ctx.setLineDash([3, 7]);
    ctx.strokeStyle = rgba(th.accentRGB, 0.07 + s * 0.2);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // 拖拽点
  ctx.beginPath();
  ctx.arc(game.dragTo[0], game.dragTo[1], 3.4 * SCALE + s * 2, 0, TAU);
  ctx.fillStyle = rgba(th.accentRGB, 0.35 + s * 0.5);
  ctx.fill();

  // 强度条：核下方的一段细横线，比环绕刻度更安静、也更易读
  const barW = 92 * SCALE;
  const barY = CY + 78 * SCALE;
  ctx.beginPath();
  ctx.moveTo(CX - barW / 2, barY);
  ctx.lineTo(CX + barW / 2, barY);
  ctx.strokeStyle = rgba(th.inkRGB, 0.10);
  ctx.lineWidth = 1;
  ctx.stroke();

  ctx.beginPath();
  ctx.moveTo(CX - barW / 2, barY);
  ctx.lineTo(CX - barW / 2 + barW * s, barY);
  ctx.strokeStyle = rgba(th.accentRGB, 0.5 + s * 0.45);
  ctx.lineWidth = 1.6;
  ctx.stroke();
}

/* ------------------ 启动 ------------------ */
resize();
window.addEventListener("resize", () => {
  const p = game.shards.map(s => [s.vx, s.vy]);
  resize();
  // 尺寸变化后按当前 SCALE 重建每个碎片，保持关卡比例一致
  game.shards.forEach((s, i) => {
    const cfg = LEVELS[game.index].shards[i];
    s.r = (cfg.r || 14) * SCALE;
    s.home = [CX + cfg.x * SCALE, CY + cfg.y * SCALE];
    s.x = clamp(s.x, s.r, W - s.r);
    s.y = clamp(s.y, s.r, H - s.r);
    s.vx = p[i][0];
    s.vy = p[i][1];
  });
});

// 开场进入选关界面
openSelect();

continueBtn.addEventListener("click", () => {
  const target = Number(continueBtn.dataset.target || 0);
  selectScreen.classList.remove("show");
  game.started = true;
  Audio_.resume();
  loadLevel(clamp(target, 0, LEVELS.length - 1), false);
});

document.getElementById("wipeBtn").addEventListener("click", () => {
  resetProgress();
  progress.lives = 3;
  game.started = false;
  renderSelect();
});

document.getElementById("menuBtn").addEventListener("click", () => {
  if (game.started) openSelect();
});

// 自动化测试钩子：用固定步长离线跑一关，不依赖 rAF 时序。
// 传入的操作序列形如 [{ t: 0, strength: 0.5 }, { t: 0.9, strength: 0.7 }]。
function simulateLevel(levelIdx, ops, maxSeconds) {
  loadLevel(levelIdx, true);
  game.shards.forEach(s => s.resetToStart());
  game.waves.length = 0;
  game.particles.length = 0;
  game.time = 0;
  game.solved = false;
  game.failed = false;
  game.failCheckAt = -1;
  game.failReason = "";
  game.waveIndex = 0;
  game.lastWaveAt = 0;
  syncOrderState(true);

  const pending = (ops || []).slice().sort((a, b) => a.t - b.t);
  const limit = maxSeconds || 12;
  let clock = 0;
  const events = [];

  while (clock < limit) {
    while (pending.length && clock >= pending[0].t) {
      const op = pending.shift();
      // 与真实输入一致：低于最小有效力度的一下不算一次发射
      if (game.waveBudget > 0 && op.strength >= MIN_WAVE_STRENGTH) {
        game.waveIndex++;
        game.lastWaveAt = game.time;
        game.waveBudget--;
        game.waves.push(new Wave(CX, CY, op.strength, game.waveIndex));
      }
    }
    game.time += STEP;
    update(STEP);
    clock += STEP;
    if (game.solved) return { ok: true, t: clock, wavesUsed: game.waveBudgetMax - game.waveBudget, events };
    if (game.failed) return { ok: false, t: clock, reason: diagnoseFailure(), events };
  }
  return {
    ok: false, t: clock, timeout: true,
    settled: game.shards.filter(s => s.settled).length,
    total: game.shards.length,
    reason: diagnoseFailure(),
  };
}

requestAnimationFrame(frame);
</script>
