<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>涟漪 · Ripple</title>
<style>
  :root {
    --bg: #0b0d10;
    --bg-soft: #12151a;
    --ink: #e8ecf1;
    --ink-dim: #6d7683;
    --ink-faint: #2c333c;
    --accent: #7fd1e8;
    --accent-dim: #3d7a8c;
    --warm: #e8b87f;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    font-family: "Inter", "Helvetica Neue", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  body { cursor: crosshair; }

  #stage {
    position: fixed;
    inset: 0;
    display: block;
    /* 手机上禁止滚动/缩放/长按菜单，否则拖拽会被浏览器手势抢走 */
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  html, body {
    overscroll-behavior: none;
    overflow: hidden;
  }

  /* ---------- HUD ---------- */
  .hud {
    position: fixed;
    z-index: 10;
    pointer-events: none;
    user-select: none;
  }

  .hud-top-left {
    top: 28px;
    left: 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* ---------- 返回 Beefreebies ---------- */
  /* 层级必须高于选关层 .select-screen(z-index:30)，否则会被整屏遮罩挡住 */
  #backToSite {
    position: fixed;
    top: 24px;
    left: 32px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 14px;
    line-height: 1;
    color: var(--ink-dim);
    text-decoration: none;
    border: 1px solid rgba(109, 118, 131, 0.22);
    background: rgba(18, 21, 26, 0.5);
    opacity: 0.32;
    transition: opacity 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  #backToSite:hover,
  #backToSite:focus-visible {
    opacity: 1;
    color: var(--accent);
    border-color: rgba(127, 209, 232, 0.5);
    outline: none;
  }

  /* 左上角 HUD 让出返回键的位置 */
  .hud-top-left {
    padding-left: 42px;
  }

  @media (max-width: 768px) {
    #backToSite {
      top: 20px;
      left: 20px;
      width: 28px;
      height: 28px;
    }

    .hud-top-left {
      top: 28px;
      left: 32px;
      padding-left: 38px;
    }
  }

  .title {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.9;
  }

  .level-name {
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--ink-dim);
    text-transform: uppercase;
    transition: opacity 0.4s ease;
  }

  .hud-top-right {
    top: 28px;
    right: 32px;
    display: flex;
    align-items: center;
    gap: 22px;
    pointer-events: auto;
  }

  .counter {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ink-dim);
    font-variant-numeric: tabular-nums;
  }

  .counter .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-dim);
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }

  .counter.full .dot {
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .icon-btn {
    width: 30px;
    height: 30px;
    border: none;
    background: transparent;
    color: var(--ink-faint);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: color 0.25s ease;
    padding: 0;
  }

  .icon-btn:hover { color: var(--ink-dim); }
  .icon-btn svg { width: 16px; height: 16px; display: block; }

  .hud-bottom {
    bottom: 30px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
  }

  .hint {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
    text-transform: uppercase;
    transition: opacity 0.5s ease;
  }

  /* ---------- Progress rail ---------- */
  .rail {
    position: fixed;
    left: 32px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 13px;
    pointer-events: none;
  }

  .rail i {
    display: block;
    width: 2px;
    height: 14px;
    background: var(--ink-faint);
    transition: background 0.4s ease, transform 0.4s ease;
  }

  .rail i.done { background: var(--accent-dim); }
  .rail i.now {
    background: var(--accent);
    transform: scaleY(1.9);
    box-shadow: 0 0 10px rgba(127, 209, 232, 0.6);
  }

  /* ---------- Overlay ---------- */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    background: rgba(11, 13, 16, 0.88);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.34s ease;
  }

  .overlay.show { opacity: 1; pointer-events: auto; }

  .overlay-inner {
    text-align: center;
    transform: translateY(8px);
    transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .overlay.show .overlay-inner { transform: translateY(0); }

  .ov-label {
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--accent-dim);
    margin-bottom: 18px;
  }

  .ov-title {
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 300;
    letter-spacing: 0.06em;
    margin-bottom: 14px;
  }

  .ov-desc {
    font-size: 13px;
    line-height: 1.9;
    color: var(--ink-dim);
    letter-spacing: 0.06em;
    max-width: 380px;
    margin: 0 auto;
  }

  .ov-actions {
    margin-top: 34px;
    display: flex;
    gap: 14px;
    justify-content: center;
  }

  .btn {
    pointer-events: auto;
    border: 1px solid var(--ink-faint);
    background: transparent;
    color: var(--ink-dim);
    font-family: inherit;
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 12px 26px;
    cursor: pointer;
    transition: all 0.28s ease;
  }

  .btn:hover {
    border-color: var(--accent-dim);
    color: var(--accent);
  }

  .btn.primary {
    border-color: var(--accent-dim);
    color: var(--accent);
  }

  .btn.primary:hover {
    background: rgba(127, 209, 232, 0.09);
    border-color: var(--accent);
  }

  /* keyboard focus only */
  .btn:focus-visible, .icon-btn:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  .fade-hidden { opacity: 0 !important; }

  /* ---------- 波数 / 生命 ---------- */
  .counter.wave-dot { color: var(--ink-dim); }
  .counter .dot.wave-dot {
    background: transparent;
    border: 1px solid var(--accent-dim);
    box-shadow: none;
    border-radius: 1px;
    transform: rotate(45deg);
  }
  .counter.empty .dot.wave-dot { border-color: var(--ink-faint); }
  .counter.empty { color: #4a525c; }
  #waveCounter.low { color: #d8a66f; }
  #waveCounter.low .dot.wave-dot { border-color: #d8a66f; }

  .lives {
    display: flex;
    gap: 7px;
    align-items: center;
  }

  .lives i {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-soft);
    transition: background 0.4s ease, box-shadow 0.4s ease, opacity 0.4s ease;
  }

  .lives i.gone {
    background: transparent;
    box-shadow: none;
    border: 1px solid var(--ink-faint);
    opacity: 0.6;
  }

  /* ---------- 选关界面 ---------- */
  .select-screen {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: grid;
    place-items: center;
    background: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.34s ease;
    overflow-y: auto;
    padding: 40px 24px;
  }

  .select-screen.show { opacity: 1; pointer-events: auto; }

  .select-inner {
    width: min(760px, 100%);
    transform: translateY(10px);
    transition: transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .select-screen.show .select-inner { transform: translateY(0); }

  .select-head { margin-bottom: 34px; }

  .select-title {
    font-size: 26px;
    font-weight: 300;
    letter-spacing: 0.14em;
    margin-bottom: 12px;
  }

  .select-sub {
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    line-height: 1.8;
    min-height: 1em;
  }

  .level-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .lv {
    position: relative;
    border: 1px solid var(--ink-faint);
    background: transparent;
    color: var(--ink-dim);
    font-family: inherit;
    text-align: left;
    padding: 15px 14px 14px;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease, transform 0.25s ease;
    min-height: 92px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
  }

  .lv:not(.locked):hover {
    border-color: var(--accent-dim);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.018);
    transform: translateY(-2px);
  }

  .lv .lv-num {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ink-faint);
  }

  .lv .lv-name {
    font-size: 12.5px;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .lv .lv-theme {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--accent-dim);
    text-transform: uppercase;
  }

  .lv.cleared { border-color: var(--accent-dim); }
  .lv.cleared .lv-num { color: var(--accent-dim); }

  .lv.current {
    border-color: var(--accent);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.025);
  }

  .lv.current .lv-num { color: var(--accent); }

  .lv.locked {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .lv.locked .lv-name { color: var(--ink-faint); }
  .lv.locked .lv-theme {
    color: var(--ink-faint);
    opacity: 0.6;
  }

  .lv .lv-mark {
    position: absolute;
    top: 13px;
    right: 13px;
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .select-foot {
    margin-top: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .select-lives {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .select-actions { display: flex; gap: 12px; }

  @media (max-width: 640px) {
    .level-grid { grid-template-columns: repeat(2, 1fr); }
    .select-inner { width: 100%; }
    .rail { display: none; }

    /* 手机：HUD 拆成两行，避免计数挤到标题上 */
    .hud-top-left { top: max(14px, env(safe-area-inset-top)); left: 16px; gap: 4px; }
    .title { font-size: 13px; letter-spacing: 0.28em; }
    .level-name { font-size: 10px; letter-spacing: 0.14em; }

    .hud-top-right {
      top: auto;
      left: 16px;
      right: 16px;
      bottom: max(12px, env(safe-area-inset-bottom));
      gap: 14px;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: nowrap;
    }
    .counter { font-size: 12px; gap: 7px; }
    .lives { margin-left: auto; flex-shrink: 0; }
    .icon-btn { padding: 6px; }
    /* 提示移到计数行上方，居中且不重叠 */
    .hud-bottom {
      bottom: calc(max(12px, env(safe-area-inset-bottom)) + 38px);
      justify-content: center;
      padding: 0 16px;
    }
    .hint {
      font-size: 10.5px;
      letter-spacing: 0.14em;
      text-align: center;
    }
    /* 选关界面在竖屏更紧凑 */
    .select-inner { padding: 0 20px; }
    .select-title { font-size: 22px; }
  }

  @media (max-width: 400px) {
    .hud-top-right { gap: 12px; }
    .counter { font-size: 11px; }
  }
</style>
</head>
<body>

<canvas id="stage"></canvas>

<!-- 返回 Beefreebies 的低调入口 -->
<a id="backToSite" href="aboutUs.html" aria-label="返回 Beefreebies" title="返回 Beefreebies">&larr;</a>

<div class="hud hud-top-left">
  <div class="title">Ripple</div>
  <div class="level-name" id="levelName">Level 01</div>
</div>

<div class="hud hud-top-right">
  <div class="counter" id="counter">
    <span class="dot"></span>
    <span id="counterText">0 / 2</span>
  </div>
  <div class="counter" id="waveCounter" title="本关剩余波纹">
