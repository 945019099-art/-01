  </button>
</div>

<div class="rail" id="rail"></div>

<div class="hud hud-bottom">
  <div class="hint" id="hint">按住并向外拖动，松手释放声波</div>
</div>

<!-- 选关界面 -->
<div class="select-screen" id="selectScreen">
  <div class="select-inner">
    <div class="select-head">
      <div class="ov-label" id="selectLabel">Ripple</div>
      <div class="select-title">选择关卡</div>
      <div class="select-sub" id="selectSub"></div>
    </div>
    <div class="level-grid" id="levelGrid"></div>
    <div class="select-foot">
      <div class="select-lives" id="selectLives"></div>
      <div class="select-actions">
        <button class="btn primary" id="continueBtn">继续</button>
        <button class="btn" id="wipeBtn">清除进度</button>
      </div>
    </div>
  </div>
</div>

<div class="overlay" id="overlay">
  <div class="overlay-inner">
    <div class="ov-label" id="ovLabel">Ripple</div>
    <div class="ov-title" id="ovTitle">涟漪</div>
    <div class="ov-desc" id="ovDesc">
      从水面的核向外拖动鼠标，<br>
      松手释放一圈声波。<br><br>
      让所有碎片同时停进核的光圈里。
    </div>
    <div class="ov-actions" id="ovActions">
      <button class="btn primary" id="ovPrimary">开始</button>
    </div>
  </div>
</div>

<script>
"use strict";

/* =========================================================
   涟漪 Ripple — 单文件解压益智游戏
   机制：从核拖拽发射一圈扩散波，波推动碎片，
        让所有碎片同时停在核的光圈内即可通关。
   ========================================================= */

/* ------------------ 基础工具 ------------------ */
const clamp = (v, a, b) => v < a ? a : (v > b ? b : v);
const lerp = (a, b, t) => a + (b - a) * t;
const TAU = Math.PI * 2;

// 与帧率无关的指数趋近
function damp(cur, target, lambda, dt) {
  return lerp(cur, target, 1 - Math.exp(-lambda * dt));
}

// 线性同余确定性随机数：同一 seed 永远产生同一串数值。
// 只用于视觉（碎片姿态相位、粒子），判定路径完全不依赖它。
function seeded(seed) {
  let x = seed >>> 0;
  return () => {
    x = (1664525 * x + 1013904223) >>> 0;
    return x / 4294967296;
  };
}

// 粒子使用独立种子流，避免粒子消耗随机数影响物理取值。
function nextParticleRand() {
  return (game.particleRnd || seeded(1))();
}

/* ------------------ 关卡数据 ------------------ */
// core: 核的初始位置（相对画布的比例，0.5/0.5 表示正中）
// goal: 核的光圈半径（像素，会按屏幕缩放）
// shards: [{ x, y, r, mass }]  x/y 为相对核的像素偏移（设计基准 900x600）
// waves: 允许同时存在的波数量上限
const BASE_W = 900, BASE_H = 600;
// 最小有效力度：低于它的一下推不动任何目标，不消耗波纹次数。
// 避免"轻轻蹭一下"成为绕过力度设计的免费补救手段。
const MIN_WAVE_STRENGTH = 0.12;

/* ------------------ 主题系统 ------------------
   每关是一个独立的小世界：配色、背景、核心形态、碎片形态、
   波的表现、音效基频都由主题决定。视觉统一由 CSS 变量与
   绘制函数读取，避免每关写一大段重复代码。
------------------------------------------------- */
const THEMES = {
  space: {
    label: "太空",
    bg: "#05070d",
    bgDeep: "#020308",
    ink: "#dfe8f5",
    accent: "#8fb8ff",
    accentSoft: "rgba(143, 184, 255, 0.14)",
    coreName: "行星",
    shardName: "小行星",
    backdrop: "stars",
