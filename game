let SCALE = 1;          // 设计尺寸 → 屏幕尺寸
let CX = 0, CY = 0;     // 核的屏幕坐标

// 光圈半径：随屏幕缩放，但保留可读下限，避免小屏上缩到看不见。
// 手机上还要保证手指能舒服地按到，所以下限随屏幕宽度变化。
function goalRadius() {
  const floor = W < 720 ? 34 : 26;
  return Math.max(LEVELS[game.index].goal * SCALE, floor);
}

// 竖屏手机：关卡横向空间很窄，若按 3:2 的设计比例缩放，
// 整个场景会缩得极小。这里改成以屏幕自身比例计算可用的缩放，
// 让竖屏也能把光圈和碎片撑到可点按的大小。
function resize() {
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  W = window.innerWidth;
  H = window.innerHeight;
  canvas.width = Math.floor(W * DPR);
  canvas.height = Math.floor(H * DPR);
  canvas.style.width = W + "px";
  canvas.style.height = H + "px";
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

  const padX = W < 720 ? 36 : 90;
  const padY = H < 720 ? 96 : 90;   // 横屏顶部 HUD + 底部提示占位

  const sx = (W - padX * 2) / BASE_W;
  const sy = (H - padY * 2) / BASE_H;
  const portrait = H > W * 1.15;

  // 竖屏：关卡内容只占中心一小块，纵向留白很多。
  // 横向铺满后再适度放大，让光圈和碎片达到适合手指的尺寸；
  // 同时受纵向可用高度约束，避免放大后碎片被挤出屏幕。
  if (portrait) {
    SCALE = Math.min(sx * 1.25, (H * 0.62) / BASE_H);
  } else {
    SCALE = Math.min(sx, sy);
  }
  SCALE = clamp(SCALE, 0.16, 1.35);

  // 核的屏幕位置：横竖屏都放在中间。
  CX = W / 2;
  CY = H / 2;
}

