    audio: { base: 168, enter: 430, scale: [0, 3, 7, 10], tail: 1.5, type: "sine", fx: "space" },
  },
  water: {
    label: "水面",
    bg: "#071018",
    bgDeep: "#03080d",
    ink: "#e2f2f6",
    accent: "#6fd8d0",
    accentSoft: "rgba(111, 216, 208, 0.14)",
    coreName: "荷叶",
    shardName: "游鱼",
    backdrop: "caustics",
    waveStyle: "ripple",
    coreStyle: "pad",
    audio: { base: 220, enter: 560, scale: [0, 2, 5, 9], tail: 1.1, type: "triangle", fx: "water" },
  },
  deep: {
    label: "深海",
    bg: "#040a14",
    bgDeep: "#010408",
    ink: "#d6e6f5",
    accent: "#4fc3e8",
    accentSoft: "rgba(79, 195, 232, 0.13)",
    coreName: "水母",
    shardName: "发光鱼",
    backdrop: "depth",
    waveStyle: "sonar",
    coreStyle: "jelly",
    audio: { base: 110, enter: 340, scale: [0, 4, 7, 11], tail: 2.0, type: "sine", fx: "deep" },
  },
  aurora: {
    label: "极光",
    bg: "#060a12",
    bgDeep: "#02040a",
    ink: "#e6f0fa",
    accent: "#9ff0d0",
    accentSoft: "rgba(159, 240, 208, 0.14)",
    coreName: "光核",
    shardName: "冰晶",
    backdrop: "aurora",
    waveStyle: "aurora",
    coreStyle: "crystal",
    audio: { base: 262, enter: 660, scale: [0, 5, 9, 12], tail: 1.3, type: "sine", fx: "aurora" },
  },
  desert: {
    label: "荒漠",
    bg: "#100c08",
    bgDeep: "#070503",
    ink: "#f2e6d6",
    accent: "#e8a95f",
    accentSoft: "rgba(232, 169, 95, 0.14)",
    coreName: "水洼",
    shardName: "沙砾",
    backdrop: "dunes",
    waveStyle: "dust",
    coreStyle: "oasis",
    audio: { base: 196, enter: 494, scale: [0, 3, 5, 10], tail: 1.2, type: "triangle", fx: "desert" },
  },
  forest: {
    label: "林间",
    bg: "#060d09",
    bgDeep: "#020604",
    ink: "#e4f2e6",
    accent: "#7fd68f",
    accentSoft: "rgba(127, 214, 143, 0.14)",
    coreName: "树桩",
    shardName: "萤火",
    backdrop: "canopy",
    waveStyle: "pollen",
