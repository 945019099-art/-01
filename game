  failReason: "",       // 失败原因（面向玩家的短提示）
  lastPush: 0,
};

/* ------------------ 进度存档与生命 ------------------ */
const SAVE_KEY = "ripple.progress.v1";

const progress = {
  unlocked: 1,          // 已解锁到第几关（1 表示只解锁第 1 关）
  cleared: [],          // 已通关的关卡索引
  lives: 3,             // 剩余生命
  failsInARow: 0,       // 连续失败次数，达到阈值才扣命
  lastLevel: 0,
};

const FAILS_PER_LIFE = 3;

function loadProgress() {
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return;
    const d = JSON.parse(raw);
    if (typeof d.unlocked === "number") progress.unlocked = clamp(d.unlocked, 1, LEVELS.length);
    if (Array.isArray(d.cleared)) progress.cleared = d.cleared.filter(n => Number.isInteger(n));
    if (typeof d.lives === "number") progress.lives = clamp(d.lives, 0, 3);
    if (typeof d.failsInARow === "number") progress.failsInARow = Math.max(0, d.failsInARow);
    if (typeof d.lastLevel === "number") progress.lastLevel = clamp(d.lastLevel, 0, LEVELS.length - 1);
  } catch (e) { /* 存档损坏则忽略，用默认值 */ }
}

function saveProgress() {
  try {
    localStorage.setItem(SAVE_KEY, JSON.stringify({
      unlocked: progress.unlocked,
      cleared: progress.cleared,
      lives: progress.lives,
      failsInARow: progress.failsInARow,
      lastLevel: progress.lastLevel,
    }));
  } catch (e) { /* 隐私模式等场景下写入失败，不影响游戏 */ }
}

function resetProgress() {
  progress.unlocked = 1;
  progress.cleared = [];
  progress.lives = 3;
  progress.failsInARow = 0;
  progress.lastLevel = 0;
  saveProgress();
}

loadProgress();


const overlay = document.getElementById("overlay");
const ovLabel = document.getElementById("ovLabel");
